From 73627f6d38bc502a8eb56719eb4e93d483203f8c Mon Sep 17 00:00:00 2001
From: Jacky Yuen <jackyyuen10@gmail.com>
Date: Thu, 19 Mar 2026 16:48:59 +0800
Subject: [PATCH] menu-btn-3

---
 libpicofe/in_sdl.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/libpicofe/in_sdl.c b/libpicofe/in_sdl.c
index 5e3142b..bce5846 100644
--- a/libpicofe/in_sdl.c
+++ b/libpicofe/in_sdl.c
@@ -516,7 +516,6 @@ static int handle_joy_event(struct in_sdl_state *state, SDL_Event *event,
 	case SDL_JOYBUTTONUP:
 		if (event->jbutton.which != state->joy_id)
 			return -2;
-		printf("DEBUG: SDL joystick button %d state=%d\n", event->jbutton.button, event->jbutton.state);
 		kc = (int)event->jbutton.button + SDLK_WORLD_0;
 		down = event->jbutton.state == SDL_PRESSED;
 		ret = 1;
@@ -707,14 +706,19 @@ static int in_sdl_update(void *drv_data, const int *binds, int *result)
 
 	collect_events(state, NULL, NULL);
 
+	printf("DEBUG in_sdl_update: state->keystate[304/64=%d] = 0x%lx\n", 304/64, state->keystate[304/64]);
+	printf("DEBUG in_sdl_update: binds[IN_BIND_OFFS(304,0)=%d] = %d\n", 304*2+0, binds[304*2+0]);
+
 	for (i = 0; i < SDLK_LAST / KEYBITS_WORD_BITS + 1; i++) {
 		mask = state->keystate[i];
 		if (mask == 0)
 			continue;
+		printf("DEBUG in_sdl_update: keystate[%d]=0x%lx\n", i, mask);
 		for (bit = 0; mask != 0; bit++, mask >>= 1) {
 			if ((mask & 1) == 0)
 				continue;
 			sym = i * KEYBITS_WORD_BITS + bit;
+			printf("DEBUG in_sdl_update: sym=%d (keystate bit %d set)\n", sym, bit);
 
 			for (b = 0; b < IN_BINDTYPE_COUNT; b++)
 				result[b] |= binds[IN_BIND_OFFS(sym, b)];
-- 
2.34.1

