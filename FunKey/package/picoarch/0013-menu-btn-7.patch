From ca872ccb595b7878c53f160cc83707c202dbafc0 Mon Sep 17 00:00:00 2001
From: Jacky Yuen <jackyyuen10@gmail.com>
Date: Thu, 19 Mar 2026 17:28:20 +0800
Subject: [PATCH] menu-btn-7

---
 core.c             |  1 -
 libpicofe/in_sdl.c | 13 -------------
 libpicofe/input.c  |  8 --------
 main.c             |  2 +-
 4 files changed, 1 insertion(+), 23 deletions(-)

diff --git a/core.c b/core.c
index 050f06b..2a1cf5b 100644
--- a/core.c
+++ b/core.c
@@ -618,7 +618,6 @@ static void pa_input_poll(void) {
 
 	in_update(actions);
 	emu_act = actions[IN_BINDTYPE_EMU];
-	printf("DEBUG pa_input_poll: actions[IN_BINDTYPE_EMU]=%u, emu_act=%u\n", actions[IN_BINDTYPE_EMU], emu_act);
 	if (emu_act) {
 		for (; !(emu_act & 1); emu_act >>= 1, which++)
 			;
diff --git a/libpicofe/in_sdl.c b/libpicofe/in_sdl.c
index c20ecc9..0464ef2 100644
--- a/libpicofe/in_sdl.c
+++ b/libpicofe/in_sdl.c
@@ -207,11 +207,8 @@ static void in_sdl_probe(const in_drv_t *drv)
 	SDL_InitSubSystem(SDL_INIT_JOYSTICK);
 
 	joycount = SDL_NumJoysticks();
-	printf("DEBUG: SDL_NumJoysticks()=%d\n", joycount);
 	for (i = 0; i < joycount; i++) {
 		joy = SDL_JoystickOpen(i);
-		printf("DEBUG: JoyOpen(%d)=%p name=%s\n",
-			i, (void*)joy, joy ? SDL_JoystickName(i) : "N/A");
 		if (joy == NULL)
 			continue;
 
@@ -519,10 +516,7 @@ static int handle_joy_event(struct in_sdl_state *state, SDL_Event *event,
 	case SDL_JOYBUTTONUP:
 		if (event->jbutton.which != state->joy_id)
 			return -2;
-		printf("DEBUG handle_joy_event: SDL_JOYBUTTON%s, button=%u\n",
-			event->type == SDL_JOYBUTTONDOWN ? "DOWN" : "UP", event->jbutton.button);
 		kc = (int)event->jbutton.button + SDLK_WORLD_0;
-		printf("DEBUG handle_joy_event: kc=%d (SDLK_WORLD_0=%d)\n", kc, SDLK_WORLD_0);
 		down = event->jbutton.state == SDL_PRESSED;
 		ret = 1;
 		break;
@@ -710,23 +704,16 @@ static int in_sdl_update(void *drv_data, const int *binds, int *result)
 	if (state->mods_bound)
 		update_modifier_binds(state, binds);
 
-	printf("DEBUG in_sdl_update: drv->prefix=%s, joy=%p, joy_id=%d\n",
-		state->drv->prefix, (void*)state->joy, state->joy_id);
 	collect_events(state, NULL, NULL);
 
-	printf("DEBUG: binds[IN_BIND_OFFS(170,0)=%d] = %d  (sym=170=SDLK_WORLD_10)\n",
-		170*2+0, binds[170*2+0]);
-
 	for (i = 0; i < SDLK_LAST / KEYBITS_WORD_BITS + 1; i++) {
 		mask = state->keystate[i];
 		if (mask == 0)
 			continue;
-		printf("DEBUG in_sdl_update: keystate[%d]=0x%lx\n", i, mask);
 		for (bit = 0; mask != 0; bit++, mask >>= 1) {
 			if ((mask & 1) == 0)
 				continue;
 			sym = i * KEYBITS_WORD_BITS + bit;
-			printf("DEBUG in_sdl_update: sym=%d (keystate bit %d set)\n", sym, bit);
 
 			for (b = 0; b < IN_BINDTYPE_COUNT; b++)
 				result[b] |= binds[IN_BIND_OFFS(sym, b)];
diff --git a/libpicofe/input.c b/libpicofe/input.c
index 50825fa..7acef2a 100644
--- a/libpicofe/input.c
+++ b/libpicofe/input.c
@@ -63,14 +63,8 @@ static int *in_alloc_binds(int drv_id, int key_count)
 	binds_d = binds + key_count * IN_BINDTYPE_COUNT;
 
 	defbinds = DRV(drv_id).defbinds;
-	fprintf(stderr, "DEBUG: SDLK_WORLD_0=%d SDLK_WORLD_10=%d SDLK_q=%d\n",
-		SDLK_WORLD_0, SDLK_WORLD_10, SDLK_q);
-	fprintf(stderr, "DEBUG in_alloc_binds: drv_id=%d, defbinds=%p, key_count=%d\n",
-		drv_id, (void*)defbinds, key_count);
 	if (defbinds != NULL) {
 		for (i = 0; ; i++) {
-			printf("DEBUG in_alloc_binds: [%d] code=%d btype=%d bit=%d\n",
-				i, defbinds[i].code, defbinds[i].btype, defbinds[i].bit);
 			if (defbinds[i].code == 0 && defbinds[i].btype == 0
 			    && defbinds[i].bit == 0)
 				break;
@@ -80,8 +74,6 @@ static int *in_alloc_binds(int drv_id, int key_count)
 		}
 	}
 
-	printf("DEBUG in_alloc_binds: binds[IN_BIND_OFFS(170,0)=%d] = %d\n",
-		170*2+0, binds_d[170*2+0]);
 	return binds;
 }
 
diff --git a/main.c b/main.c
index a3a1c02..bc4c2d6 100644
--- a/main.c
+++ b/main.c
@@ -406,7 +406,7 @@ static void perform_emu_action(void) {
 	case EACTION_NONE:
 		break;
 	case EACTION_MENU:
-		printf("DEBUG: EACTION_MENU triggered!\n"); return;
+		printf("DEBUG: EACTION_MENU triggered!\n");
 		showload();
 		toggle_fast_forward(1); /* Force FF off */
 		sram_write();
-- 
2.34.1

