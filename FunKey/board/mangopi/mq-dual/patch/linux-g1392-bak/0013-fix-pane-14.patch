From 42dfd10010458a7e9b9e62d0cff7df018a2b34ae Mon Sep 17 00:00:00 2001
From: Jacky Yuen <jackyyuen10@gmail.com>
Date: Fri, 9 Jan 2026 02:35:29 +0800
Subject: [PATCH] fix-pane-14

Signed-off-by: Jacky Yuen <jackyyuen10@gmail.com>
---
 drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c b/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
index 204abafa7..c1f169d57 100644
--- a/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
+++ b/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
@@ -671,7 +671,11 @@ static s32 lcd_clk_config(struct disp_device *lcd)
 	memset(&clk_info, 0, sizeof(struct lcd_clk_info));
 	disp_al_lcd_get_clk_info(lcd->hwdev_index, &clk_info,
 				 &lcdp->panel_info);
+		
 	dclk_rate = lcdp->panel_info.lcd_dclk_freq * 1000000;	/* Mhz -> hz */
+	DE_WRN("clk_info: tcon_div=%d, dsi_div=%d, lcd_div=%d\n", 
+       clk_info.tcon_div, clk_info.dsi_div, clk_info.lcd_div);
+	DE_WRN("panel: dclk_freq=%d lcd_dsi_if=%d\n", lcdp->panel_info.lcd_dclk_freq, lcdp->panel_info.lcd_dsi_if);
 	if (lcdp->panel_info.lcd_if == LCD_IF_DSI) {
 		lcd_rate = dclk_rate * clk_info.dsi_div;
 		pll_rate = lcd_rate * clk_info.lcd_div;
-- 
