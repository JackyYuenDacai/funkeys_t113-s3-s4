+/* drivers/video/sunxi/disp2/disp/lcd/g1392.c
+ *
+ * Copyright (c) 2017 Allwinnertech Co., Ltd.
+ * Author: zhengxiaobin <zhengxiaobin@allwinnertech.com>
+ *
+ * G1392 panel driver
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+[lcd0]
+ * lcd_used            = 1
+ *
+ * lcd_driver_name     = "g1392"
+ *
+ * lcd_bl_0_percent    = 0
+ * lcd_bl_40_percent   = 23
+ * lcd_bl_100_percent  = 100
+ * lcd_backlight       = 88
+ *
+ * lcd_if              = 4
+ * lcd_x               = 1080
+ * lcd_y               = 1240
+ * lcd_width           = 65
+ * lcd_height          = 75
+ * lcd_dclk_freq       = 25
+ *
+ * lcd_pwm_used        = 0
+ * lcd_pwm_ch          = 8
+ * lcd_pwm_freq        = 50000
+ * lcd_pwm_pol         = 1
+ * lcd_pwm_max_limit   = 255
+ *
+ * lcd_hbp             = 36
+ * lcd_ht              = 1080
+ * lcd_hspw            = 4
+ * lcd_vbp             = 8
+ * lcd_vt              = 1240
+ * lcd_vspw            = 4
+ *
+ * lcd_dsi_if          = 0
+ * lcd_dsi_lane        = 2
+ * lcd_dsi_format      = 0
+ * lcd_dsi_te          = 0
+ * lcd_dsi_eotp        = 0
+ *
+ * lcd_frm             = 0
+ * lcd_io_phase        = 0x0000
+ * lcd_hv_clk_phase    = 0
+ * lcd_hv_sync_polarity= 0
+ * lcd_gamma_en        = 0
+ * lcd_bright_curve_en = 0
+ * lcd_cmap_en         = 0
+ *
+ * lcdgamma4iep        = 22
+ *
+ * ;lcd_bl_en           = port:PD09<1><0><default><1>
+ * lcd_power            = "vcc-lcd"
+ * lcd_pin_power        = "vcc18-dsi"
+ * lcd_pin_power1    	= "vcc-pd"
+ *
+ * ;reset
+ * lcd_gpio_0          = port:PB06<1><0><default><1>
+*/
+#include "g1392.h"
+
+static void lcd_power_on(u32 sel);
+static void lcd_power_off(u32 sel);
+static void lcd_bl_open(u32 sel);
+static void lcd_bl_close(u32 sel);
+
+static void lcd_panel_init(u32 sel);
+static void lcd_panel_exit(u32 sel);
+
+#define panel_reset(sel, val) sunxi_lcd_gpio_set_value(sel, 0, val)
+
+static void lcd_cfg_panel_info(struct panel_extend_para *info)
+{
+	u32 i = 0, j = 0;
+	u32 items;
+	u8 lcd_gamma_tbl[][2] = {
+	    {0, 0},     {15, 15},   {30, 30},   {45, 45},   {60, 60},
+	    {75, 75},   {90, 90},   {105, 105}, {120, 120}, {135, 135},
+	    {150, 150}, {165, 165}, {180, 180}, {195, 195}, {210, 210},
+	    {225, 225}, {240, 240}, {255, 255},
+	};
+
+	u32 lcd_cmap_tbl[2][3][4] = {
+	    {
+		{LCD_CMAP_G0, LCD_CMAP_B1, LCD_CMAP_G2, LCD_CMAP_B3},
+		{LCD_CMAP_B0, LCD_CMAP_R1, LCD_CMAP_B2, LCD_CMAP_R3},
+		{LCD_CMAP_R0, LCD_CMAP_G1, LCD_CMAP_R2, LCD_CMAP_G3},
+	    },
+	    {
+		{LCD_CMAP_B3, LCD_CMAP_G2, LCD_CMAP_B1, LCD_CMAP_G0},
+		{LCD_CMAP_R3, LCD_CMAP_B2, LCD_CMAP_R1, LCD_CMAP_B0},
+		{LCD_CMAP_G3, LCD_CMAP_R2, LCD_CMAP_G1, LCD_CMAP_R0},
+	    },
+	};
+
+	items = sizeof(lcd_gamma_tbl) / 2;
+	for (i = 0; i < items - 1; i++) {
+		u32 num = lcd_gamma_tbl[i + 1][0] - lcd_gamma_tbl[i][0];
+
+		for (j = 0; j < num; j++) {
+			u32 value = 0;
+
+			value =
+			    lcd_gamma_tbl[i][1] +
+			    ((lcd_gamma_tbl[i + 1][1] - lcd_gamma_tbl[i][1]) *
+			     j) /
+				num;
+			info->lcd_gamma_tbl[lcd_gamma_tbl[i][0] + j] =
+			    (value << 16) + (value << 8) + value;
+		}
+	}
+	info->lcd_gamma_tbl[255] = (lcd_gamma_tbl[items - 1][1] << 16) +
+				   (lcd_gamma_tbl[items - 1][1] << 8) +
+				   lcd_gamma_tbl[items - 1][1];
+
+	memcpy(info->lcd_cmap_tbl, lcd_cmap_tbl, sizeof(lcd_cmap_tbl));
+}
+
+static s32 lcd_open_flow(u32 sel)
+{
+	LCD_OPEN_FUNC(sel, lcd_power_on, 0);
+	LCD_OPEN_FUNC(sel, lcd_panel_init, 10);
+	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 10);
+	LCD_OPEN_FUNC(sel, lcd_bl_open, 0);
+	return 0;
+}
+
+static s32 lcd_close_flow(u32 sel)
+{
+	LCD_CLOSE_FUNC(sel, lcd_bl_close, 0);
+	LCD_CLOSE_FUNC(sel, lcd_panel_exit, 10);
+	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
+	LCD_CLOSE_FUNC(sel, lcd_power_off, 0);
+
+	return 0;
+}
+
+static void lcd_power_on(u32 sel)
+{
+    tick_printf("%s:kg1392 start\n", __func__);
+	sunxi_lcd_pin_cfg(sel, 1);
+	sunxi_lcd_power_enable(sel, 0);
+	sunxi_lcd_power_enable(sel, 1);
+	sunxi_lcd_delay_ms(25);
+
+	/* reset lcd by gpio */
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(25);
+	panel_reset(sel, 0);
+	sunxi_lcd_delay_ms(25);
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(25);
+    tick_printf("%s:kg1392 end\n", __func__);
+}
+
+static void lcd_power_off(u32 sel)
+{
+	sunxi_lcd_pin_cfg(sel, 0);
+	sunxi_lcd_delay_ms(1);
+	panel_reset(sel, 0);
+	sunxi_lcd_delay_ms(1);
+	sunxi_lcd_power_disable(sel, 0);
+}
+
+static void lcd_bl_open(u32 sel)
+{
+	sunxi_lcd_pwm_enable(sel);
+	sunxi_lcd_backlight_enable(sel);
+}
+
+static void lcd_bl_close(u32 sel)
+{
+	sunxi_lcd_backlight_disable(sel);
+	sunxi_lcd_pwm_disable(sel);
+}
+
+#define REGFLAG_DELAY         0XFE
+#define REGFLAG_END_OF_TABLE  0xFC   /* END OF REGISTERS MARKER */
+
+struct LCM_setting_table {
+	u8 cmd;
+	u32 count;
+	u8 para_list[18];
+};
+
+
+ 
+static struct LCM_setting_table lcm_initialization_setting[] = {
+    {0xFE, 1, {0x00}},
+ 
+    {0xC2, 1, {0x08}},
+
+     {0x35, 1, {0x08}},
+ 
+    {0x51, 2, {0x07, 0xFF}},
+
+    {0x11, 1, {0x00}},
+    {REGFLAG_DELAY, REGFLAG_DELAY, {120} },
+
+    {0x29, 1, {0x00}},
+    {REGFLAG_DELAY, REGFLAG_DELAY, {80} },
+
+    {REGFLAG_END_OF_TABLE, REGFLAG_END_OF_TABLE, {} }
+
+};
+
+static void lcd_panel_init(u32 sel)
+{
+	u32 i = 0;
+
+	sunxi_lcd_dsi_clk_enable(sel);
+	sunxi_lcd_delay_ms(10);
+
+	for (i = 0;; i++) {
+		if (lcm_initialization_setting[i].cmd == REGFLAG_END_OF_TABLE)
+			break;
+		else if (lcm_initialization_setting[i].cmd == REGFLAG_DELAY)
+			sunxi_lcd_delay_ms(lcm_initialization_setting[i].count);
+		else {
+			dsi_dcs_wr(0, lcm_initialization_setting[i].cmd,
+				   lcm_initialization_setting[i].para_list,
+				   lcm_initialization_setting[i].count);
+		}
+	}
+}
+
+static void lcd_panel_exit(u32 sel)
+{
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x28);
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x10);
+}
+
+/*sel: 0:lcd0; 1:lcd1*/
+static s32 lcd_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
+{
+	return 0;
+}
+
+struct __lcd_panel g1392_panel = {
+	/* panel driver name, must mach the name of
+	 * lcd_drv_name in sys_config.fex
+	 */
+	.name = "g1392",
+	.func = {
+		.cfg_panel_info = lcd_cfg_panel_info,
+			.cfg_open_flow = lcd_open_flow,
+			.cfg_close_flow = lcd_close_flow,
+			.lcd_user_defined_func = lcd_user_defined_func,
+	},
+};
