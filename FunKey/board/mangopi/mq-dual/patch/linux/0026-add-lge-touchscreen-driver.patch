+					__func__, (ts->app_data[i].app == APP_HOME ? "Home" : ((ts->app_data[i].app == APP_CONTACTS) ? "Contacts" : "N/A")),
+					ts->app_data[i].icon_size, ts->app_data[i].touch_slop, ts->app_data[i].version);
