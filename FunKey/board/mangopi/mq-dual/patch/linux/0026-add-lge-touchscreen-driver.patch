+/*******************************************************************
+*  These values is to calculate the angle between two vectors.
+*  998600   // 3(degree)
+*  996200   // 5(degree)
+*  992600   // 7(degree)
+*  984800   // 10(degree)
+*  974400   // 13(degree)
+* *******************************************************************/
+#define DELTA_DEGREE_HIGH_THRESHOLD     998600   // 3(degree)
+#define DELTA_DEGREE_LOW_THRESHOLD      996200   // 5(degree)
+#define VELOCITY_LOW_THRESHOLD          20
+#define VELOCITY_HIGH_THRESHOLD         30
+#define MOVE_CHK_CNT                    5
+#define VSYNC_TIMING                    500      // 4.2*1000
+#define INCHTOMILLI                     254
+#define DPI                             392
+struct pen_prediction_data {
+	int predict_x;
+	int predict_y;
+	int prev_predict_x;
+	int prev_predict_y;
+	int prev_est_x;
+	int prev_est_y;
+	int prev_unit_x;
+	int prev_unit_y;
+	int prev_x;
+	int prev_y;
+	u16 move_cnt;
+	u16 predict_ratio;
+};
+
+struct pen_data {
+	u64 id;
+	//
+	u16 in_range;
+	u16 contact;
+	u16 swit1;
+	u16 swit2;
+	//
+	u16 batt;
+	u16 x;
