+* Brief: read register
+* Input: i2c info, reg address, reg value
+* Output: get reg value
+* Return: fail <0
+***********************************************************************/
+int fts_read_reg(struct i2c_client *client, u8 regaddr, u8 *regvalue)
+{
+
+	return fts_i2c_read(client, &regaddr, 1, regvalue, 1);
+
+}
