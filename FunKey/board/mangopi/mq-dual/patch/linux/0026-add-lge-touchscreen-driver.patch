+#if defined(CONFIG_SECURE_TOUCH)
+static ssize_t show_secure_touch_devinfo(struct device *dev,
+				char *buf)
+{
+	struct touch_core_data *ts = to_touch_core(dev);
+	int ret = 0;
+	TOUCH_TRACE();
