+static int __init touch_sub_core_init(void)
+{
+	TOUCH_TRACE();
+	async_schedule(touch_sub_core_async_init, NULL);
+	return 0;
+}
+
+static void __exit touch_sub_core_exit(void)
+{
+	TOUCH_TRACE();
+	platform_driver_unregister(&touch_sub_core_driver);
+}
