+		atomic_set(&ts->state.ime, value);
+		ret = touch_sub_blocking_notifier_call(NOTIFY_IME_STATE,
+			&ts->state.ime);
+		TOUCH_I("%s : %s(%d), ret = %d\n",
+			__func__, ime_str[value], value, ret);
