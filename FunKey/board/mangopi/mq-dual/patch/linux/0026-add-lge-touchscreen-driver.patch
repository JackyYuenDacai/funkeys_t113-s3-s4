+static int touch_sub_core_probe_normal(struct platform_device *pdev)
+{
+	struct touch_sub_core_data *ts;
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	////////////////////////////////////////////////
+	TOUCH_I("pdev info name:%s id:%d", pdev->name,
+			pdev->id);
+
+	/* sub module */
+	if (plist_sub == NULL) {
+		plist_sub = kzalloc(sizeof(*plist_sub), GFP_KERNEL);
+		if (!plist_sub) {
+			TOUCH_E("Failed to allocate memory for plist_sub\n");
+			return -ENOMEM;
+		}
+	}
+	/* check specific platform device num */
+	if (pdev->id > 0) {
+		struct module_data *md;
+//		int data = 1;
+//		char buf[100] = {0};
+
+		/* check module IC */
+		TOUCH_I("call from module to do someting\n");
+		md = (struct module_data *) pdev->dev.platform_data;
+
+		plist_sub->sub_dev[pdev->id - 1] = pdev->dev.parent;
+
+		ret = md->m_driver.match(md->dev);
+		if (ret < 0) {
+			TOUCH_I("Not found module IC. Skip module probe. %d\n", ret);
+			return 0;
+		}
+
+		md->m_driver.notify = module_notify_func;
+		md->m_driver.write_file = module_write_file;
+		md->m_driver.log_file_size_check = module_log_file_size_check;
+		md->m_driver.probe(md->dev);
+
+		//md->m_driver.func(md->dev, data, buf);
+		//TOUCH_I("%s\n", buf);
+
+		if (md->wq != NULL) {
+			queue_delayed_work(md->wq, &md->init_work, 0);
+		}
+
+		if (plist_sub->touch_sub_core_data != NULL) {
+			touch_sub_init_sysfs_module(md, plist_sub->touch_sub_core_data);
+#ifdef CONFIG_LGE_TOUCH_SUB_PEN
+			ts = (struct touch_sub_core_data *) plist_sub->touch_sub_core_data;
+			if (ts->driver->pen_func != NULL) {
+				ts->driver->pen_func = md->m_driver.func;
+				TOUCH_I("%s Pen Driver Handler Connected\n", __func__);
+			}
+#endif
+		} else {
+			TOUCH_I("%s Main PDev was not called", __func__);
+		}
+
+		return 0;
+	}
+	////////////////////////////////////////////////
+
+	ts = (struct touch_sub_core_data *) pdev->dev.platform_data;
+	plist_sub->touch_sub_core_data = (void *)ts;
+
+	atomic_set(&ts->state.core, CORE_PROBE);
+	ret = touch_sub_init_platform_data(ts);
+	if (ret < 0) {
+		TOUCH_E("failed to initialize platform_data\n");
+		return -EINVAL;
+	}
+
+	ret = ts->driver->probe(ts->dev);
+	if (ret < 0) {
+		TOUCH_E("failed to device probe\n");
+		return ret;
+	}
+
+	/* set defalut lpwg value because of AAT */
+	ts->lpwg.screen = 1;
+	ts->lpwg.sensor = PROX_FAR;
+
+	ts->driver->power(ts->dev, POWER_ON);
+	ts->driver->power(ts->dev, POWER_OFF);
+	ts->driver->power(ts->dev, POWER_ON);
+
+	touch_sub_init_locks(ts);
+	ret = touch_sub_init_works(ts);
+	if (ret < 0) {
+		TOUCH_E("failed to initialize works\n");
+		goto error_init_work;
+	}
+
+	ret = touch_sub_init_input(ts);
+	if (ret < 0) {
+		TOUCH_E("failed to register input device(ret:%d)\n", ret);
+		goto error_init_input;
+	}
+
+#if defined(CONFIG_LGE_TOUCH_SUB_DEX)
+	if (ts->role.use_dex_mode) {
+		ret = dex_sub_input_init(ts->dev);
+		if (ret < 0) {
+			goto error_init_input;
+		}
+	}
+#endif
+    ts->irq = gpio_to_irq(ts->int_pin);
+
+    TOUCH_I("irq: %d - pin:%d\n",ts->irq,ts->int_pin);
+
+	ret = touch_sub_request_irq(ts->irq, touch_sub_irq_handler,
+			touch_sub_irq_thread, ts->irqflags | IRQF_ONESHOT,
+			LGE_TOUCH_SUB_NAME, ts);
+	if (ret < 0) {
+		TOUCH_E("failed to request_thread_irq(irq:%d, ret:%d)\n",
+				ts->irq, ret);
+		goto error_request_irq;
+	}
+
+	touch_sub_disable_irq(ts->irq);
+	touch_sub_init_pm(ts);
+
+	touch_sub_init_notify(ts);
+
+	ret = touch_sub_init_uevent(ts);
+	ret = touch_sub_init_sysfs(ts);
+
+	atomic_set(&ts->state.swivel, SWIVEL_NOT_INITIALIZED);
+
+	TOUCH_I("hw_reset_delay : %d ms\n", ts->caps.hw_reset_delay);
+	queue_delayed_work(ts->wq, &ts->init_work,
+			msecs_to_jiffies(ts->caps.hw_reset_delay));
+
+	return 0;
+error_request_irq:
+	touch_sub_free_irq(ts->irq, ts->dev);
+error_init_input:
+	if (ts->input) {
+		input_mt_destroy_slots(ts->input);
+		input_free_device(ts->input);
+	}
+error_init_work:
+	if (ts->wq)
+		destroy_workqueue(ts->wq);
+
+	return ret;
+}
+
+static int touch_sub_core_probe_etc(struct platform_device *pdev)
+{
+	struct touch_sub_core_data *ts;
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	ts = (struct touch_sub_core_data *) pdev->dev.platform_data;
+
+	ret = touch_sub_init_platform_data(ts);
+	if (ret < 0) {
+		TOUCH_E("failed to initialize platform_data\n");
+		return -EINVAL;
+	}
+
+	ret = ts->driver->probe(ts->dev);
+	if (ret < 0) {
+		TOUCH_E("failed to device probe\n");
+		return ret;
+	}
+
+	touch_sub_init_locks(ts);
+	ret = touch_sub_init_works(ts);
+	if (ret < 0) {
+		TOUCH_E("failed to initialize works\n");
+		return ret;
+	}
+
+	touch_sub_init_pm(ts);
+	touch_sub_init_notify(ts);
+
+	return ret;
+}
