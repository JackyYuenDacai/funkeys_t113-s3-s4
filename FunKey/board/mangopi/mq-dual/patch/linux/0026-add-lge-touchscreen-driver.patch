+{
+	struct touch_core_data *ts = to_touch_core(dev);
+	int ret = 0;
+	int value = 0;
+
+	if (kstrtos32(buf, 10, &value) < 0)
+		return count;
+
+	if (value < 0 || value > 1) {
+		TOUCH_E("invalid value(%d), use only 0 and 1\n", value);
+		return count;
+	}
+
+	mutex_lock(&ts->lock);
+	s3707_grip_status(dev, &value);
+	ret = s3707_grip_set(dev);
+	if (ret < 0)
+		TOUCH_E("failed to set grip set (ret: %d)\n", ret);
+	mutex_unlock(&ts->lock);
+
+	return count;
+}
