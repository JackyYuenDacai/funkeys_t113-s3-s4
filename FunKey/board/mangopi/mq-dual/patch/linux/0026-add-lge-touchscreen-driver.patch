+
+void touch_sub_msleep(unsigned int msecs)
+{
+	if (msecs >= 20)
+		msleep(msecs);
+	else
+		usleep_range(msecs * 1000, msecs * 1000);
+}
+
+void touch_sub_interrupt_control(struct device *dev, int on_off)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+
+	TOUCH_TRACE();
+	TOUCH_D(TRACE, "%s(%d)!\n", __func__, on_off);
+
+	if (on_off) {
+		if (atomic_cmpxchg(&ts->state.irq_enable, 0, 1) == 0) {
+			touch_sub_enable_irq(ts->irq);
+
+			if (ts->role.use_lpwg)
+				touch_sub_enable_irq_wake(ts->irq);
+		}
+	} else {
+		if (atomic_cmpxchg(&ts->state.irq_enable, 1, 0) == 1) {
+			if (ts->role.use_lpwg)
+				touch_sub_disable_irq_wake(ts->irq);
+
+			touch_sub_disable_irq(ts->irq);
+		}
+	}
+}
+
+int touch_sub_snprintf(char *buf, int size, const char *fmt, ...)
+{
+
+	va_list args;
+	int ret = 0;
+
+	if(size <= 0) {
+		TOUCH_E("size is negative!\n");
+		return 0;
+	}
+
+	va_start(args, fmt);
+	ret = vsnprintf(buf, (size_t)size, fmt, args);
+	va_end(args);
+
+	if (ret < 0) {
+		TOUCH_E("snprintf error. change ret value(%d -> 0)\n", ret);
+		ret = 0;
+	}
+
+	return ret;
+}
+
