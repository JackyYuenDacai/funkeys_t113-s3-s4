+{
+	struct touch_core_data *ts = to_touch_core(dev);
+	int ret = sysfs_create_group(&ts->kobj, &sw42902_abt_attribute_group);
+
+	if (ret < 0)
+		TOUCH_E("failed to create sysfs for abt\n");
+	return ret;
+}
