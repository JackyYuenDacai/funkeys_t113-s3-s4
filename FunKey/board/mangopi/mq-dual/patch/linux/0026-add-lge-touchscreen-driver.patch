+		msleep(fts_updateinfo_curr.delay_aa);
+		fts_write_reg(client, 0xfc, FTS_UPGRADE_55);
+		msleep(fts_updateinfo_curr.delay_55);
+
+		/*********Step 2:Enter upgrade mode and switch protocol*****/
+		auc_i2c_write_buf[0] = FTS_UPGRADE_55;
