+#pragma pack(push, 1)
+/* TCP */
+enum ECommCMD {
+	TCP_REG_READ = 0x80,
+	TCP_REG_WRITE,
+	TCP_FRAME_START,
+	TCP_REPORT_START,
+	TCP_SYNC_START,
+	TCP_SYNCDEBUG_START,
+	TCP_CAPTURE_STOP,
+	TCP_CONNECT_CMD,
+	TCP_DISCONNECT_CMD
+};
+
+enum ECommRes {
+	eCommRes_Success	 = 0,
+	eCommRes_WriteFailed = 0x8001
+};
+
+typedef struct {
+	u8		cmd;
+	u16		addr;
+	u16		size;
+} TPacketHdr, *PPacketHdr;
+
+struct s_comm_packet {
+	TPacketHdr	hdr;
+	union {
+		u32		value;
+		u8		frame[4000];
+	} data;
+};
