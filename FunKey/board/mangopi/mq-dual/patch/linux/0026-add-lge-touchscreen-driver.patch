+{
+	int ret = 0;
+
+	if (cmd != DONT_USE_CMD) {
+		ret = stop_firmware(dev, cmd);
+		if (ret < 0)
+			goto out;
+	}
+
+	ret = sw42000_reg_write(dev, tc_tsp_test_data_offset, (u8 *)&offset, sizeof(offset));
+	if (ret < 0)
+		goto out;
+
+	ret = sw42000_reg_read(dev, data_access_addr, (void *)buf, size);
+	if (ret < 0)
+		goto out;
+
+out:
+	return ret;
+}
