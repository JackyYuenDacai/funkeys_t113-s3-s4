+		ret = snprintf(buf + ret, PAGE_SIZE - ret,
+				"LCD Off. Test Result : Fail\n");
+		return ret;
+	}
+
+	mutex_lock(&ts->lock);
+	touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
