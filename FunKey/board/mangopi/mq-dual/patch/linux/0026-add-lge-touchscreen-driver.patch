+		TOUCH_I("%s size error offset[%d] size[%d]\n", __func__, (int)off, (int)count);
+		count = 0;
+	}
+
+error:
+	if (frame_buf != NULL)
+		kfree(frame_buf);
+
+	return count;
+}
