+static int rmidev_i2c_read(struct device *dev,
+		unsigned short addr, unsigned char *data, unsigned short length)
+{
+	int ret = 0;
+	u8 page_old = 0;
+	u8 page_new = 0;
+	bool page_changed;
+
+	/* page read */
+	ret = s3706_read(dev, PAGE_SELECT_REG, &page_old, sizeof(page_old));
+
+	if (ret < 0) {
+		TOUCH_E("Failed to read from Page_Select register\n");
+		return ret;
+	}
+
+	page_new = (addr >> 8);
+
+	/* page compare & change */
+	if (page_old == page_new) {
+		page_changed = false;
+	} else {
+		ret = s3706_write(dev, PAGE_SELECT_REG,
+					&page_new, sizeof(page_new));
+
+		if (ret < 0) {
+			TOUCH_E("Failed to change Page_Select register\n");
+			return ret;
+		}
+
+		page_changed = true;
+	}
+
+	/* read register */
+	ret = s3706_read(dev, (u8)(addr & ~(MASK_8BIT << 8)), data, length);
+
+	if (ret < 0) {
+		TOUCH_E("Failed to write register(addr=0x%04x)\n", addr);
+		return ret;
+	}
+
+	/* page restore */
+	if (page_changed) {
+		ret = s3706_write(dev, PAGE_SELECT_REG,
+					&page_old, sizeof(page_old));
+
+		if (ret < 0) {
+			TOUCH_E("Failed to restore Page_Select register\n");
+			return ret;
+		}
+	}
+
+	return 0;
+}
