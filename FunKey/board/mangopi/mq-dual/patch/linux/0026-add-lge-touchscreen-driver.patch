+void hx83113a_ic_reset(struct device *dev, uint8_t loadconfig, uint8_t int_off)
+{
+	struct himax_ts_data *d = to_himax_data(dev);
+
+	TOUCH_I("%s,status: loadconfig=%d,int_off=%d\n", __func__, loadconfig, int_off);
+
+	if (d->rst_gpio >= 0) {
