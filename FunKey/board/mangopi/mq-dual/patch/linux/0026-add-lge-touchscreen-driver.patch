+					TOUCH_I("F [%d] = %d , %d, %d\n", i,  self_data[i],
+							SimpleImage[0], SimpleImage[1]);
+					ret += snprintf(w_buf + ret, BUF_SIZE - ret, "F [%d] = %d\n", i,
+							self_data[i]);
