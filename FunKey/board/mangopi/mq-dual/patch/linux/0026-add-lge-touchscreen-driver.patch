+				&page_old, sizeof(page_old));
+
+	if (ret < 0) {
+		TOUCH_E("Failed to read from Page_Select register\n");
+		return ret;
+	}
+
+	page_new = (addr >> 8);
+
+	/* page compare & change */
+	if (page_old == page_new) {
+		page_changed = false;
+	} else {
+		ret = s3707_write(dev, PAGE_SELECT_REG, &page_new, sizeof(page_new));
+
+		if (ret < 0) {
+			TOUCH_E("Failed to change Page_Select register\n");
+			return ret;
+		}
+
+		page_changed = true;
+	}
+
+	/* write register */
+	ret = s3707_write(dev, (u8)(addr & ~(MASK_8BIT << 8)), data, length);
+
+	if (ret < 0) {
+		TOUCH_E("Failed to write register(addr=0x%04x)\n", addr);
+		return ret;
+	}
+
+	/* page restore */
+	if (page_changed) {
+		ret = s3707_write(dev, PAGE_SELECT_REG,
+					&page_old, sizeof(page_old));
+
+		if (ret < 0) {
+			TOUCH_E("Failed to restore Page_Select register\n");
+			return ret;
+		}
+	}
+
+	return 0;
+}
