+static int module_notify_func(int control, int data) {
+	switch (control) {
+		case MODULE_FIRMWARE_UPGRADE:
+			TOUCH_I("%s: %d", __func__, data);
+#ifdef CONFIG_LGE_DD_TEMP_BRINGUP
+			notify_touch_sub_version_check(data);
+#endif
+			break;
+		case 2:
+			break;
+	};
+
+	return 0;
+}
