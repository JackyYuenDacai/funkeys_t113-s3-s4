+static int touch_sub_core_probe(struct platform_device *pdev)
+{
+	struct touch_sub_core_data *ts;
+	int boot_mode = TOUCH_NORMAL_BOOT;
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	mutex_lock(&touch_sub_probe_lock);
+
+	if (pdev->id > 0) {
+		TOUCH_I("pdev->id = %d, no need to check bootmode\n", pdev->id);
+		ret = touch_sub_core_probe_normal(pdev);
+		goto out;
+	}
+
+	ts = (struct touch_sub_core_data *) pdev->dev.platform_data;
+
+	boot_mode = touch_sub_check_boot_mode(ts->dev);
+	TOUCH_I("%s: boot_mode = %d\n", __func__, boot_mode);
+	if (boot_mode == TOUCH_CHARGER_MODE
+			|| boot_mode == TOUCH_LAF_MODE
+			|| boot_mode == TOUCH_RECOVERY_MODE) {
+		ret = touch_sub_core_probe_etc(pdev);
+		goto out;
+	}
+
+	ret = touch_sub_core_probe_normal(pdev);
+
+out:
+	mutex_unlock(&touch_sub_probe_lock);
+	return ret;
+}
+
+static int touch_sub_core_remove(struct platform_device *pdev)
+{
+	struct touch_sub_core_data *ts;
+
+	TOUCH_TRACE();
+
+	TOUCH_I("%s\n", __func__);
+
+	///////////////////////////////////////////////////////////////////
+	TOUCH_I("pdev->id:%d num_resources:%d" , pdev->id,
+			pdev->num_resources);
+
+	if (plist_sub != NULL && pdev->id > 0) {
+		struct module_data *md = to_module(plist_sub->sub_dev[pdev->id - 1]);
+		if (md != NULL)
+			md->m_driver.remove(md->dev);
+
+		plist_sub->sub_dev[pdev->id - 1] = NULL;
+
+		return 0;
+	}
+	////////////////////////////////////////////////////////////////////
+
+	ts = (struct touch_sub_core_data *) pdev->dev.platform_data;
+
+	atomic_set(&ts->state.core, CORE_REMOVE);
+
+#if defined(CONFIG_HAS_EARLYSUSPEND)
+	unregister_early_suspend(&ts->early_suspend);
+#elif defined(CONFIG_DRM_MSM) && defined(CONFIG_FB)
+	msm_drm_unregister_client(&ts->drm_notif);
+#elif defined(CONFIG_FB)
+	fb_unregister_client(&ts->fb_notif);
+#endif
+
+	kobject_del(&ts->kobj);
+
+	touch_sub_blocking_notifier_unregister(&ts->blocking_notif);
+
+	touch_sub_atomic_notifier_unregister(&ts->atomic_notif);
+
+	destroy_workqueue(ts->wq);
+	device_init_wakeup(ts->dev, false);
+
+	touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+	touch_sub_free_irq(ts->irq, ts->dev);
+
+	input_unregister_device(ts->input);
+
+	ts->driver->remove(ts->dev);
+	ts->driver->power(ts->dev, POWER_OFF);
+
+	devm_kfree(ts->dev, ts);
+
+	kfree(plist_sub);
+
+	return 0;
+}
+
+static void touch_sub_core_shutdown(struct platform_device *pdev)
+{
+	struct touch_sub_core_data *ts;
+
+	TOUCH_TRACE();
+
+	TOUCH_I("%s\n", __func__);
+
+	TOUCH_I("pdev->id:%d num_resources:%d" , pdev->id,
+			pdev->num_resources);
+	if (pdev->id > 0) {
+		TOUCH_I("%s : do not release platform data\n", __func__);
+		return ;
+	}
+
+	ts = (struct touch_sub_core_data *) pdev->dev.platform_data;
+
+	atomic_set(&ts->state.core, CORE_SHUTDOWN);
+
+#if defined(CONFIG_SUB_SECURE_TOUCH)
+	if (atomic_read(&ts->st_enabled)) {
+		secure_touch_sub_stop(ts, false);
+		complete(&ts->st_irq_processed);
+	}
+#endif
+
+	if (ts->dev == NULL)
+		return;
+
+	touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+	touch_sub_free_irq(ts->irq, ts->dev);
+
+	if (ts->driver->shutdown)
+		ts->driver->shutdown(ts->dev);
+}
