+int fts_Gesture_init(struct input_dev *input_dev)
+{
+        //init_para(480,854,60,0,0);
+	input_set_capability(input_dev, EV_KEY, KEY_POWER);
+	input_set_capability(input_dev, EV_KEY, KEY_GESTURE_U); 
