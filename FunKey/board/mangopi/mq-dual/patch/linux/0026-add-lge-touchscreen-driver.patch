+		memset(&(buf2.enable), 0, sizeof(buf2.enable));
+
+		ret = sw42902_sub_reg_write(dev, ABT_CMD + SWIPE2_ON,
+				&(buf2.enable), sizeof(buf2.enable));
+		if (ret < 0)
+			TOUCH_E("failed to clear SWIPE2_ENABLE register (ret = %d)\n",
+					ret);
+	}
+
+	return ret;
+}
