+void print_sd_log(char *buf)
+{
+	int i = 0;
+	int index = 0;
+
+	while (index < strlen(buf) && buf[index] != '\0' && i < LOG_BUF_SIZE - 1) {
+		logbuf[i++] = buf[index];
+
+		/* Final character is not '\n' */
+		if ((index == strlen(buf) - 1 || i == LOG_BUF_SIZE - 2)
+				&& logbuf[i - 1] != '\n')
+			logbuf[i++] = '\n';
+
+		if (logbuf[i - 1] == '\n') {
+			logbuf[i - 1] = '\0';
+			if (i - 1 != 0)
+				TOUCH_I("%s\n", logbuf);
+
+			i = 0;
+		}
+		index++;
+	}
