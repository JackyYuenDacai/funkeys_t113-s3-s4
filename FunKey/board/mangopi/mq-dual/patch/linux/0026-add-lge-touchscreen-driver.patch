+static void sw42902_lcd_mode(struct device *dev, u32 mode)
+{
+	struct sw42902_data *d = to_sw49202_data(dev);
+
+	d->prev_lcd_mode = d->lcd_mode;
+	d->lcd_mode = mode;
+	TOUCH_D(TRACE, "lcd_mode: %d (prev: %d)\n", d->lcd_mode, d->prev_lcd_mode);
+}
