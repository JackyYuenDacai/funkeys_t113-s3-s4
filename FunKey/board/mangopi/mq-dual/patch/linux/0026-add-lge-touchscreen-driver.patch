+static void rmidev_attn(struct device *ts_dev,
+		unsigned char intr_mask)
+{
+	TOUCH_TRACE();
+
+	if (!rmidev)
+		return;
+
+	if (rmidev->pid && (rmidev->intr_mask & intr_mask))
