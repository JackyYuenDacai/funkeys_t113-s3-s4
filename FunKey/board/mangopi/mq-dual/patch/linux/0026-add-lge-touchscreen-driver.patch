+static int sw42000_swivel_status(struct device *dev, u32 state)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int boot_mode = 0;
+	int prev_status = atomic_read(&ts->state.prev_swivel);
+	int cur_status = atomic_read(&ts->state.swivel);
+	TOUCH_TRACE();
+
+	TOUCH_I("Swivel state: %d (Swivel prev_state : %d)\n", cur_status, prev_status);
+
+	boot_mode = touch_sub_check_boot_mode(dev);
+	if(boot_mode == TOUCH_NORMAL_BOOT)
+	{
+		if (cur_status == SWIVEL_HALF)
+		{
+			TOUCH_I("%s : HALF SWIVEL!!!! INTERRUPT DISABLE!!!",__func__);
+			touch_sub_report_all_event(ts);
+			touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+		}
+		else
+		{
+			if(atomic_read(&ts->state.sleep) != IC_DEEP_SLEEP)
+			{
+				TOUCH_I("%s : Swivel change complete!!!! INTERRUPT Enable",__func__);
+				touch_sub_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+			}
+			else
+			{
+				TOUCH_I("%s :  deep sleep status!!!! skip interrupt control!!",__func__);
+			}
+		}
+	}
+
+	return 0;
+}
