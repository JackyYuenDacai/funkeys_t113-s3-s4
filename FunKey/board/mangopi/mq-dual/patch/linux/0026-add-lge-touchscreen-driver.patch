+static ssize_t rmidev_sysfs_release_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct touch_core_data *ts = to_touch_core(rmidev->ts_dev);
+	unsigned int input;
+
+	TOUCH_TRACE();
+
+	if (kstrtou32(buf, 10, &input) < 0)
