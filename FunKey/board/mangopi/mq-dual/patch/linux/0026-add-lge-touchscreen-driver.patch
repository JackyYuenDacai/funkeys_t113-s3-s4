+						"%5d ", frame_buf[i]);
+		}
+		ret += snprintf(kobj_log_buf + ret, LOG_MAX_BUF - ret, "\n");
+		TOUCH_I("%s\n", log_buf);
+		kobj_log_buf[ret + 1] = '\n';
+	}
+
+	if (ret < count)
+		count = ret;
+	ret = ret - count;
+
+	if ((off < LOG_MAX_BUF) && (off + count <= LOG_MAX_BUF)) {
+		memcpy(buf, &kobj_log_buf[off], count);
