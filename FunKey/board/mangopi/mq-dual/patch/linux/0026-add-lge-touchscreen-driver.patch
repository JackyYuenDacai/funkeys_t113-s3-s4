+static ssize_t store_noise_log(struct device *dev,
+		const char *buf, size_t count)
+{
+	struct sw42000_data *d = to_sw42000_data(dev);
+
+	int value = 0;
+
+	TOUCH_TRACE();
+
+	if (kstrtos32(buf, 10, &value) < 0)
+		return count;
