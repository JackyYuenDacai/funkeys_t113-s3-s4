+int sw42902_check_abnormal_signal(struct device *dev)
+{
+	struct sw42902_data *d = to_sw49202_data(dev);
+
+	if (d->info.abnormal_sts != 0) {
+		TOUCH_I("Check signal: %s%d\n",
+				(d->info.abnormal_sts >> 6 & 0x1) > 0 ? "-":"+",
+				(d->info.abnormal_sts & 0x3F) * 4);
+	}
+
+	return 0;
+}
