+	if (kstrtos32(buf, 10, &value) < 0)
+		return count;
+
+	if (value == LOCKSCREEN_UNLOCK || value == LOCKSCREEN_LOCK) {
+		atomic_set(&ts->state.lockscreen, value);
+		TOUCH_I("%s : %s(%d)\n", __func__,
+				value ? "LOCK" : "UNLOCK", value);
