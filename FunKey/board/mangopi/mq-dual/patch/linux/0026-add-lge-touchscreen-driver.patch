+#define TCI_MODE_NUM 4
+static const char *lpwg_mode_strr[TCI_MODE_NUM] = {
+	"NONE",
+	"DOUBLE_TAP",
+	"PASSWORD",
+	"PASSWORD_ONLY",
+};
