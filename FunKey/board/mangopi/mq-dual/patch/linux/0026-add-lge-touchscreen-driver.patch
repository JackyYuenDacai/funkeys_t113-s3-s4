+			LGE_TOUCH_NAME, ts);
+	touch_interrupt_control(rmidev->ts_dev, INTERRUPT_ENABLE);
+
+	TOUCH_I("%s: Attention interrupt enabled\n", __func__);
+
+	//rmi4_data->reset_device(rmi4_data, false);
+	//rmi4_data->stay_awake = false;
+
+	return count;
