+static const char *driving_cmd_str[LCD_MODE_NUM] = {
+	"LCD_MODE_U0",
+	"LCD_MODE_U2_UNBLANK",
+	"LCD_MODE_U2",
+	"LCD_MODE_U3",
+	"LCD_MODE_U3_PARTIAL",
+	"LCD_MODE_U3_QUICKCOVER",
+	"LCD_MODE_STOP",
