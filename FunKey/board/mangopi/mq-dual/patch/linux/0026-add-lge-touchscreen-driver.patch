+#if defined(__SUPPORT_CLK_CTRL)
+static int sw42902_clock(struct device *dev, u32 onoff)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+
+	u32 reg_val = 0;
+
+	if (onoff) {
+		if (ts->bus_type == HWIF_SPI) {
+			sw42902_sub_reg_write(dev, SPI_OSC_CTL, &onoff, sizeof(onoff));
+			atomic_set(&ts->state.sleep, IC_NORMAL);
+			touch_sub_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+			TOUCH_I("IC Clock(0x%x) = %s\n",
+					SPI_OSC_CTL, (onoff == 0) ? "0 (off)" : "1 (on)");
+
+		} else {
+			/*
+			 *	i2c can not turn on the clock with the command.
+			 *	Use "Power on sequence"
+			 */
+			atomic_set(&ts->state.sleep, IC_NORMAL);
+			sw42902_sub_reset_ctrl(dev, HW_RESET_SYNC);
+		}
+	} else {
+		touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+
+		//pllosc_sel
+		sw42902_sub_reg_read(dev, SYS_CLK_CTL, &reg_val , sizeof(reg_val));
+		reg_val &= ~(pllosc_sel);
+		sw42902_sub_reg_write(dev, SYS_CLK_CTL, &reg_val, sizeof(reg_val));
+		TOUCH_I("SYS_CLK_CTL(0x%x) value(0x%x) pllosc_sel(0x%x) \n", SYS_CLK_CTL, reg_val, pllosc_sel);
+		touch_sub_msleep(1);
+
+		//xe_en
+		sw42902_sub_reg_read(dev, SYS_PLL_CTL1, &reg_val , sizeof(reg_val));
+		reg_val &= ~(xe_en);
+		sw42902_sub_reg_write(dev, SYS_PLL_CTL1, &reg_val, sizeof(reg_val));
+		TOUCH_I("SYS_PLL_CTL1(0x%x) value(0x%x) xe_en(0x%x) \n", SYS_PLL_CTL1, reg_val, xe_en);
+		touch_sub_msleep(1);
+
+		//ldo15_bias_mute
+		sw42902_sub_reg_read(dev, LDO15_CTL, &reg_val , sizeof(reg_val));
+		reg_val &= ~(r_ldo15_bias_mute);
+		sw42902_sub_reg_write(dev, LDO15_CTL, &reg_val, sizeof(reg_val));
+		TOUCH_I("LDO15_CTL(0x%x) value(0x%x) r_ldo15_bias_mute(0x%x) \n", LDO15_CTL, reg_val, r_ldo15_bias_mute);
+		touch_sub_msleep(1);
+
+		//ldo_bias
+		sw42902_sub_reg_read(dev, SYS_LDO_CTL, &reg_val , sizeof(reg_val));
+		reg_val &= ~(ldo_bias);
+		sw42902_sub_reg_write(dev, SYS_LDO_CTL, &reg_val, sizeof(reg_val));
+		TOUCH_I("SYS_LDO_CTL(0x%x) value(0x%x) ldo_bias(0x%x) \n", SYS_LDO_CTL, reg_val, ldo_bias);
+		touch_sub_msleep(1);
+
+		//pll_pd_n
+		sw42902_sub_reg_read(dev, SYS_PLL_CTL1, &reg_val , sizeof(reg_val));
+		reg_val &= ~(pll_pd_n);
+		sw42902_sub_reg_write(dev, SYS_PLL_CTL1, &reg_val, sizeof(reg_val));
+		TOUCH_I("SYS_PLL_CTL1(0x%x) value(0x%x) pll_pd_n(0x%x) \n", SYS_PLL_CTL1, reg_val, pll_pd_n);
+		touch_sub_msleep(1);
+
+		//osc_pd_n
+		sw42902_sub_reg_read(dev, SYS_OSC_CTL, &reg_val , sizeof(reg_val));
+		reg_val &= ~(osc_pd_n);
+		sw42902_sub_reg_write(dev, SYS_OSC_CTL, &reg_val, sizeof(reg_val));
+		TOUCH_I("SYS_OSC_CTL(0x%x) value(0x%x) osc_pd_n(0x%x) >>> \n", SYS_OSC_CTL, reg_val, osc_pd_n);
+
+		atomic_set(&ts->state.sleep, IC_DEEP_SLEEP);
+
+	}
+
+	return 0;
+}
+#else	/* __SUPPORT_CLK_CTRL */
+static inline int sw42902_clock(struct device *dev, u32 onoff)
+{
+	TOUCH_NOOP();
+	return 0;
+}
+#endif	/* __SUPPORT_CLK_CTRL */
