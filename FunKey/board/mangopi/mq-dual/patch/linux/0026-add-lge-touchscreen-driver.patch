+static int sw42902_sw_reset(struct device *dev, int mode)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	struct sw42902_data *d = to_sw49202_data(dev);
+	int ret = 0;
+
+	TOUCH_I("%s : SW Reset(mode%d)\n", __func__, mode);
+
+	if (mode == SW_RESET) {
+		/* [CM3 reset] Touch F/W jump reset vector and do not code flash dump */
+		sw42902_write_value(dev, SYS_RST_CTL, 2);
+		touch_sub_msleep(20);
+		sw42902_write_value(dev, SYS_RST_CTL, 0);
+	} else if (mode == SW_RESET_CODE_DUMP) {
+		/* [system reset] Touch F/W resister reset and do code flash dump */
+		sw42902_write_value(dev, SYS_RST_CTL, 1);
+		touch_sub_msleep(20);
+		sw42902_write_value(dev, SYS_RST_CTL, 0);
+	} else {
+		TOUCH_E("%s Invalid SW reset mode!!\n", __func__);
+	}
+
+	atomic_set(&d->init, IC_INIT_NEED);
+
+	queue_delayed_work(ts->wq, &ts->init_work, msecs_to_jiffies(ts->caps.sw_reset_delay));
+
+	return ret;
+}
+
+int sw42902_sub_hw_reset(struct device *dev, int mode)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	struct sw42902_data *d = to_sw49202_data(dev);
+
+	TOUCH_I("%s : HW Reset(mode:%d)\n", __func__, mode);
+	touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+	touch_sub_gpio_direction_output(ts->reset_pin, 0);
+
+	touch_sub_msleep(1);
+
+	touch_sub_gpio_direction_output(ts->reset_pin, 1);
+	atomic_set(&d->init, IC_INIT_NEED);
+	atomic_set(&ts->state.sleep, IC_NORMAL);
+
+	TOUCH_I("hw_reset_delay:%dms", ts->caps.hw_reset_delay);
+
+	if (mode == HW_RESET_ASYNC) {
+		queue_delayed_work(ts->wq, &ts->init_work, msecs_to_jiffies(ts->caps.hw_reset_delay));
+	} else if (mode == HW_RESET_SYNC) {
+		touch_sub_msleep(ts->caps.hw_reset_delay);
+		ts->driver->init(dev);
+		touch_sub_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+	} else {
+		TOUCH_E("%s Invalid HW reset mode!!\n", __func__);
+	}
+
+	return 0;
+}
+
+int sw42902_sub_power_reset(struct device *dev, int mode)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	struct sw42902_data *d = to_sw49202_data(dev);
+
+	TOUCH_I("%s : HW POWER Reset(mode:%d)\n", __func__, mode);
+	touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+	sw42902_power(ts->dev, POWER_OFF);
+	sw42902_power(ts->dev, POWER_ON);
+
+	atomic_set(&d->init, IC_INIT_NEED);
+	atomic_set(&ts->state.sleep, IC_NORMAL);
+
+	TOUCH_I("hw_reset_delay:%dms", ts->caps.hw_reset_delay);
+
+	touch_sub_msleep(ts->caps.hw_reset_delay);
+	ts->driver->init(dev);
+	touch_sub_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+
+	return 0;
+}
+
+int sw42902_sub_reset_ctrl(struct device *dev, int ctrl)
+{
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	switch (ctrl) {
+	case SW_RESET:
+	case SW_RESET_CODE_DUMP:
+		ret = sw42902_sw_reset(dev, ctrl);
+		break;
+
+	case HW_RESET_ASYNC:
+	case HW_RESET_SYNC:
+		ret = sw42902_sub_hw_reset(dev, ctrl);
+		break;
+	case HW_RESET_POWER:
+		ret = sw42902_sub_power_reset(dev, ctrl);
+		break;
+	default:
+		TOUCH_E("UnKnown ctrl, %d\n", ctrl);
+		break;
+	}
+
+	return ret;
+}
+
+static int sw42902_power(struct device *dev, int ctrl)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	struct sw42902_data *d = to_sw49202_data(dev);
+	struct project_param *param = &d->p_param;
+
+	TOUCH_TRACE();
+
+	switch (ctrl) {
+	case POWER_OFF:
+#if defined(CONFIG_SUB_SECURE_TOUCH)
+		if (atomic_read(&ts->st_enabled))
+			secure_touch_sub_stop(ts, true);
+#endif
+		if (param->touch_sub_power_control_en == FUNC_ON) {
+			TOUCH_I("%s, off\n", __func__);
+			atomic_set(&d->init, IC_INIT_NEED);
+			touch_sub_gpio_direction_output(ts->reset_pin, 0);
+			touch_sub_msleep(1);
+			touch_sub_power_1_8_vdd(dev, 0);
+			touch_sub_msleep(1);
+			touch_sub_power_3_3_vcl(dev, 0);
+			touch_sub_msleep(1);
+		} else {
+			TOUCH_I("%s, off Not Supported\n", __func__);
+		}
+		break;
+
+	case POWER_ON:
+		if (param->touch_sub_power_control_en == FUNC_ON) {
+			TOUCH_I("%s, on\n", __func__);
+			touch_sub_power_3_3_vcl(dev, 1);
+			touch_sub_msleep(1);
+			touch_sub_power_1_8_vdd(dev, 1);
+			touch_sub_msleep(10);
+			touch_sub_gpio_direction_output(ts->reset_pin, 1);
+		} else {
+			TOUCH_I("%s, on Not Supported\n", __func__);
+		}
+		break;
+	case POWER_HW_RESET_ASYNC:
+		TOUCH_I("%s, HW reset\n", __func__);
+		sw42902_sub_reset_ctrl(dev, HW_RESET_ASYNC);
+		break;
+
+	case POWER_SW_RESET:
+		sw42902_sub_reset_ctrl(dev, SW_RESET);
+		break;
+	case POWER_SLEEP:
+	case POWER_WAKE:
+	default:
+		TOUCH_I("%s, Not Supported. case: %d\n", __func__, ctrl);
+		break;
+	}
+
+	return 0;
+}
