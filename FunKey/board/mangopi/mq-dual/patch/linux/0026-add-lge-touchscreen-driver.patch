+		ts->swipe[SWIPE_L2].enable = false;
+		ts->swipe[SWIPE_R2].enable = false;
+		break;
+	case PAY_TYPE_SWIPE_L:
+		ts->swipe[SWIPE_U].enable = false;
+		ts->swipe[SWIPE_L2].enable = true;
+		ts->swipe[SWIPE_R2].enable = false;
+		break;
+	case PAY_TYPE_SWIPE_R:
+		ts->swipe[SWIPE_U].enable = false;
+		ts->swipe[SWIPE_L2].enable = false;
+		ts->swipe[SWIPE_R2].enable = true;
+		break;
+	default:
