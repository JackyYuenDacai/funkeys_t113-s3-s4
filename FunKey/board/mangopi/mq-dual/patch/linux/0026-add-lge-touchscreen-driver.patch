+	d->lpwg_abs.enable = (bool)enable;
+
+	mutex_lock(&ts->lock);
+	ret = s3706_lpwg_abs_enable(dev, d->lpwg_abs.enable);
+	if (ret < 0)
+		TOUCH_E("failed to set lpwg_abs enable (ret: %d)\n", ret);
+
+	mutex_unlock(&ts->lock);
+
+	return count;
+}
