+static int tune_u8_print(int num_ch, u8 *tune_val, char *log_buf, int offset)
+{
+	int i;
+	int temp = 0;
+	for (i = 0; i < num_ch; i++) {
+		if (((tune_val[i] >> 4) & 1) == 0) {
+			temp = tune_val[i] & 0xF;
+
+			offset += snprintf(log_buf + offset,
+					tc_tune_code_size - offset,
+					"-%d ", temp);
+		} else if (((tune_val[i] >> 4) & 1) == 1) {
+			temp = tune_val[i] & 0xF;
+
+			offset += snprintf(log_buf + offset,
+					tc_tune_code_size - offset,
+					"%d  ", temp);
+		} else {
+			offset += snprintf(log_buf + offset,
+					tc_tune_code_size - offset,
+					"ISB  ");
+		}
+	}
+	offset += snprintf(log_buf + offset, tc_tune_code_size - offset, "\n");
+
+	return offset;
+}
