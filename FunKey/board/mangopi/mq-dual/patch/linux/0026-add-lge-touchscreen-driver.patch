+			TOUCH_I("fingerprint_area_meet = %x\n", d->touch_info.fingerprint_area_meet);
+			offset += bits;
+			break;
+		case TOUCH_0D_BUTTONS_STATE:
+			bits = config_data[config_idx];
+			config_idx++;
+			ret = s3618_get_report_data(dev, offset, bits, &data);
