+				&ts->state.debug_tool);
+
+		TOUCH_I("%s : %s, ret = %d\n",
+				__func__,
+				(data == DEBUG_TOOL_ENABLE) ?
+				"Debug Tool Enabled" : "Debug Tool Disabled",
+				ret);
+	} else {
+		TOUCH_I("%s : Unknown debug tool set value %d\n",
+			__func__, data);
+	}
+
+	return count;
+}
