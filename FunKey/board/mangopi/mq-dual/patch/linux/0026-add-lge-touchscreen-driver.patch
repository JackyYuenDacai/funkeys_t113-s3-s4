+	TOUCH_TRACE();
+
+	ret = switchPage(dev, DEFAULT);
+	if (ret < 0) {
+		TOUCH_I("[%s] retry switchPage, fail\n", __func__);
+		return ret;
+	}
+	data = 0x04;
+	ret = Write8BitRegisters(dev, DEVICE_CONTROL_REG, &data, 1);
+	if (ret < 0) {
+		TOUCH_E("failed to write DEVICE_CONTROL_REG - ret:%d\n", ret);
+		return ret;
+	}
+
+	ret = switchPage(dev, COMMON);
+	if (ret < 0) {
+		TOUCH_I("[%s] retry switchPage, fail\n", __func__);
+		return ret;
+	}
+
+	return ret;
+}
