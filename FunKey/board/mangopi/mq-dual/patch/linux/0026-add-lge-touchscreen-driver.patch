+static ssize_t store_touch_dex_mode(struct device *dev,
+		const char *buf, size_t count)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int enable = 0;
+	int offset_y = 0;
+	int start_x = 0;
+	int start_y = 0;
+	int width = 0;
+	int height = 0;
+
+	TOUCH_TRACE();
+
+	if (sscanf(buf, "%d %d %d %d %d %d", &enable, &offset_y, &start_x,
+				&start_y, &width, &height) <= 0)
+		return count;
+
+	TOUCH_I("%s: enable = %d, offset_y = %d, start_x = %d, start_y = %d, width = %d, height = %d\n",
+			__func__, enable, offset_y, start_x,
+			start_y, width, height);
+
+	if ((enable > 1) || (enable < 0)) {
+		TOUCH_E("invalid enable(%d)\n", enable);
+		return count;
+	}
+
+	if (ts->touch_dex.enable != enable) {
+		mutex_lock(&ts->lock);
+		touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+		touch_sub_report_all_event(ts);
+		atomic_set(&ts->state.dex_mode, enable);
+		touch_sub_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+		mutex_unlock(&ts->lock);
+	}
+
+	if (enable) {
+		ts->touch_dex.enable = true;
+		ts->touch_dex.area.x1 = (start_x & 0xFFFF);
+		ts->touch_dex.area.y1 = (start_y & 0xFFFF);
+		ts->touch_dex.area.x2 = ts->touch_dex.area.x1 + (width & 0xFFFF) - 1;
+		ts->touch_dex.area.y2 = ts->touch_dex.area.y1 + (height & 0xFFFF) - 1;
+		ts->touch_dex.button_area.x1 = (start_x >> 16) & 0xFFFF;
+		ts->touch_dex.button_area.y1 = (start_y >> 16) & 0xFFFF;
+
+		if (((width >> 16) & 0xFFFF) == 0) {// if button does not exist, button_area.x2 and button_area.y2 is 0
+			ts->touch_dex.button_area.x2 = 0;
+			ts->touch_dex.button_area.y2 = 0;
+			ts->touch_dex.button_enable = false;
+		} else {
+			ts->touch_dex.button_area.x2 = ts->touch_dex.button_area.x1 + ((width >> 16) & 0xFFFF) - 1;
+			ts->touch_dex.button_area.y2 = ts->touch_dex.button_area.y1 + ((height >> 16) & 0xFFFF) - 1;
+			ts->touch_dex.button_enable = true;
+		}
+
+		TOUCH_I("%s: enable = %d, button_enable = %d, dex_area(%d,%d)(%d,%d), button_area(%d,%d)(%d,%d)\n",
+			__func__, ts->touch_dex.enable, ts->touch_dex.button_enable,
+			ts->touch_dex.area.x1, ts->touch_dex.area.y1, ts->touch_dex.area.x2, ts->touch_dex.area.y2,
+			ts->touch_dex.button_area.x1, ts->touch_dex.button_area.y1, ts->touch_dex.button_area.x2, ts->touch_dex.button_area.y2);
+
+
+	} else {
+		ts->touch_dex.enable = false;
+		ts->touch_dex.button_enable = false;
+		TOUCH_I("%s: disable = %d, button_disable = %d\n", __func__, ts->touch_dex.enable, ts->touch_dex.button_enable);
+	}
+
+
+	return count;
+}
+static ssize_t store_touch_dex_mode_pad(struct device *dev,
+		const char *buf, size_t count)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int enable = 0;
+	int offset_y = 0;
+	int start_x = 0;
+	int start_y = 0;
+	int width = 0;
+	int height = 0;
+	int start_x1 = 0;
+	int start_y1 = 0;
+	int width1 = 0;
+	int height1 = 0;
+
+	TOUCH_TRACE();
+
+	if (sscanf(buf, "%d %d %d %d %d %d %d %d %d %d", &enable, &offset_y, &start_x,
+				&start_y, &width, &height, &start_x1, &start_y1, &width1, &height1) <= 0)
+		return count;
+
+	TOUCH_I("%s: enable = %d, offset_y = %d, start_x = %d, start_y = %d, width = %d, height = %d, start_x1 = %d, start_y1 = %d, width1 = %d, height1 = %d\n",
+			__func__, enable, offset_y, start_x, start_y, width, height, start_x1, start_y1, width1, height1);
+
+	if ((enable > 1) || (enable < 0)) {
+		TOUCH_E("invalid enable(%d)\n", enable);
+		return count;
+	}
+
+	if (ts->touch_dex.enable != enable) {
+		mutex_lock(&ts->lock);
+		touch_sub_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+		touch_sub_report_all_event(ts);
+//		atomic_set(&ts->state.dex_mode, enable);
+		touch_sub_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+		mutex_unlock(&ts->lock);
+	}
+
+	if (enable) {
+		ts->touch_dex.enable_pad = enable;
+		ts->touch_dex.rotate = offset_y;
+		/* set vertical wheel area */
+		ts->touch_dex.wheel_area.x1 = (start_x >> 16) & 0xFFFF;
+		ts->touch_dex.wheel_area.y1 = (start_y >> 16) & 0xFFFF;
+		ts->touch_dex.wheel_area.x2 = ts->touch_dex.wheel_area.x1
+			+ ((width >> 16) & 0xFFFF);
+		ts->touch_dex.wheel_area.y2 = ts->touch_dex.wheel_area.y1
+			+ ((height >> 16) & 0xFFFF);
+
+		ts->touch_dex.wheel_area.x3 = start_x & 0xFFFF;
+		ts->touch_dex.wheel_area.y3 = start_y & 0xFFFF;
+		ts->touch_dex.wheel_area.x4 = ts->touch_dex.wheel_area.x3
+			+ (width & 0xFFFF);
+		ts->touch_dex.wheel_area.y4 = ts->touch_dex.wheel_area.y3
+			+ (height & 0xFFFF);
+
+		/* set horizontal wheel area */
+		ts->touch_dex.wheel_area1.x1 = (start_x1 >> 16) & 0xFFFF;
+		ts->touch_dex.wheel_area1.y1 = (start_y1 >> 16) & 0xFFFF;
+		ts->touch_dex.wheel_area1.x2 = ts->touch_dex.wheel_area1.x1
+			+ ((width1 >> 16) & 0xFFFF);
+		ts->touch_dex.wheel_area1.y2 = ts->touch_dex.wheel_area1.y1
+			+ ((height1 >> 16) & 0xFFFF);
+
+		/* set out Btn area */
+		ts->touch_dex.btn_area.x1 = start_x1 & 0xFFFF;
+		ts->touch_dex.btn_area.y1 = start_y1 & 0xFFFF;
+		ts->touch_dex.btn_area.x2 = ts->touch_dex.btn_area.x1
+			+ (width1 & 0xFFFF);
+		ts->touch_dex.btn_area.y2 = ts->touch_dex.btn_area.y1
+			+ (height1 & 0xFFFF);
+
+		TOUCH_I("enable_pad: %d Wheel_area1(%d,%d-%d,%d) Wheel_area2(%d,%d-%d,%d) Wheel_area3(%d,%d-%d,%d) Btn_area(%d,%d-%d,%d)\n",
+			ts->touch_dex.enable_pad,
+
+			ts->touch_dex.wheel_area.x1,
+			ts->touch_dex.wheel_area.y1,
+			ts->touch_dex.wheel_area.x2,
+			ts->touch_dex.wheel_area.y2,
+
+			ts->touch_dex.wheel_area.x3,
+			ts->touch_dex.wheel_area.y3,
+			ts->touch_dex.wheel_area.x4,
+			ts->touch_dex.wheel_area.y4,
+
+			ts->touch_dex.wheel_area1.x1,
+			ts->touch_dex.wheel_area1.y1,
+			ts->touch_dex.wheel_area1.x2,
+			ts->touch_dex.wheel_area1.y2,
+
+			ts->touch_dex.btn_area.x1,
+			ts->touch_dex.btn_area.y1,
+			ts->touch_dex.btn_area.x2,
+			ts->touch_dex.btn_area.y2);
+	} else {
+		ts->touch_dex.enable_pad = false;
+		TOUCH_I("enable_pad - disable(%d)\n", ts->touch_dex.enable_pad);
+	}
+
+
+	return count;
+}
