+#elif defined(CONFIG_TPD_ROTATE_270)
+	tpd_rotate_270(&x, &y);
+#elif defined(CONFIG_TPD_ROTATE_180)
+	tpd_rotate_180(&x, &y);
+#endif
+
+#ifdef TPD_SOLVE_CHARGING_ISSUE
+	if (0 != x) {
+#else
+	{
+#endif
+		input_report_abs(tpd->dev, ABS_MT_TRACKING_ID, id);
+		TPD_DEBUG("%s x:%d y:%d p:%d\n", __func__, x, y, p);
