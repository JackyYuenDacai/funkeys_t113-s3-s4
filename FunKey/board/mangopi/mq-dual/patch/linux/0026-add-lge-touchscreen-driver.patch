+int fts_create_sysfs(struct i2c_client * client)
+{
+	int err;
+	err = sysfs_create_group(&client->dev.kobj, &fts_attribute_group);
+	if (0 != err) 
+	{
+		dev_err(&client->dev, "%s() - ERROR: sysfs_create_group() failed.\n", __func__);
