+	TOUCH_TRACE();
+
+	/* Compare 2D area */
+	for (j = 0; j < (int)F12_2DRxCount; j++) {
+		for (i = 0; i < (int)F12_2DTxCount; i++) {
+			if ((j == 0) && (i >= 4) && (i <= 11))
