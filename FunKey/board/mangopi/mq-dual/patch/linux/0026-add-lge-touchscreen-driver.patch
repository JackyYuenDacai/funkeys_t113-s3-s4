+		TOUCH_E("f12_reg.ctrl is not allocated\n");
+		atomic_set(&d->state.scan_pdt, true);
+		return -ENOMEM;
+	}
+
+error:
+	ret_page = s3706_set_page(dev, DEFAULT_PAGE);
+	if (ret_page < 0) {
+		TOUCH_E("failed to set DEFAUT_PAGE (ret: %d)\n", ret_page);
+		ret = ret_page;
+	}
+
+	return ret;
+}
