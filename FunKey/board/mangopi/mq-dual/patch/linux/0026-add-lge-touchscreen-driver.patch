+
+	if (hx83113a_proc_init()) {
+		TOUCH_E(" %s: himax_common proc_init failed!\n", __func__);
+		return -ENOMEM;
+	}
+
+#ifdef CONFIG_LGE_TOUCH_HIMAX_HX83113A_DEBUG
+	if (hx83113a_debug_init(dev))
+		TOUCH_E(" %s: debug initial failed!\n", __func__);
+#endif
