+				address,
+				(unsigned char *)buf,
+				length);
+		if (retval < 0) {
+			TOUCH_E("%s: Failed to read data\n", __func__);
+			return retval;
+		}
+	} else {
+		return -EINVAL;
+	}
+
+/*
+	if (!rmidev->concurrent)
+		goto exit;
+
+	if (address != rmi4_data->f01_data_base_addr)
+		goto exit;
+
+	if (length <= 1)
+		goto exit;
+
+	intr_status = buf[1];
