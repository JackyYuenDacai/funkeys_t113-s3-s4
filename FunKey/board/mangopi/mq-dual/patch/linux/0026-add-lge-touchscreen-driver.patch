+static int sw42000_sub_register_sysfs(struct device *dev)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	TOUCH_I("sw42000 sysfs reigster\n");
+	ret = sysfs_create_group(&ts->kobj, &sw42000_attribute_group);
+	if (ret < 0) {
+		TOUCH_E("sw42000 sysfs register failed\n");
+
+		goto error;
+	}
+
+	ret = sw42000_sub_prd_register_sysfs(dev);
+#if defined(__SUPPORT_ABT)
+	ret = sw42000_sub_abt_register_sysfs(dev);
+#endif
+	if (ret < 0) {
+		TOUCH_E("sw42000 register failed\n");
+		goto error;
+	}
+
+
+
+	return 0;
+
+error:
+	kobject_del(&ts->kobj);
+
+	return ret;
+}
