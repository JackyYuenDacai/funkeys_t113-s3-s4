+	TOUCH_I("devInfo: %s\n", ts->touch_ic_name);
+
+	ret = snprintf(buf + ret, PAGE_SIZE, ts->touch_ic_name);
+	ret += snprintf(buf + ret, PAGE_SIZE - ret, ".%d", ts->bus_type);
