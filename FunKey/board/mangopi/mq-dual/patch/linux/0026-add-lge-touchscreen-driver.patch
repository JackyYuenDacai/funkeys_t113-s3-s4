+static int touch_sub_check_driver_function(struct touch_sub_core_data *ts)
+{
+	if (ts->driver->probe &&
+			ts->driver->remove &&
+			ts->driver->shutdown &&
+			ts->driver->suspend &&
+			ts->driver->resume &&
+			ts->driver->init &&
+			ts->driver->irq_handler &&
+			ts->driver->power &&
+			ts->driver->upgrade &&
+			ts->driver->esd_recovery &&
+			ts->driver->lpwg &&
+//			ts->driver->swipe_enable &&
+			ts->driver->notify &&
+			ts->driver->init_pm &&
+			ts->driver->register_sysfs &&
+			ts->driver->set &&
+			ts->driver->get)
+		return 0;
+
+	return -EPERM;
+}
