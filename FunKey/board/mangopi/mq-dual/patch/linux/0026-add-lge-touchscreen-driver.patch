+				d->ai_pick.total_area.y2 = ts->caps.max_y;
+		}
+	}
+
+	d->ai_pick.pre_enable = d->ai_pick.enable;
+	d->ai_pick.enable = (bool)enable;
+
+	mutex_lock(&ts->lock);
+	sw42902_ai_pick_enable(dev, d->ai_pick.enable);
+	mutex_unlock(&ts->lock);
+
+	return count;
