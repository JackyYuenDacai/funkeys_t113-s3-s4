+static void setErr_Array(uint8_t trx, bool err)
+{
+	uint8_t byte = trx / 8;
+	uint8_t bit = trx % 8;
+
+	if (err)
+		err_array[byte] = (err_array[byte] | (0x01 << bit));
+	else
+		err_array[byte] = (err_array[byte] - (0x01 << bit));
+}
