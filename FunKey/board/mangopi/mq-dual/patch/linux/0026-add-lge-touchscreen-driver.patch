+/* Flexible Report */
+#define REPORT_BASE_HDR				(12)
+#define REPORT_PACKET_SIZE			(sizeof(struct sw42902_touch_sub_data))
+#define REPORT_PACKET_BASE_COUNT	(1)
+
+static int sw42902_irq_read_data(struct device *dev)
+{
+	struct sw42902_data *d = to_sw49202_data(dev);
+	struct sw42902_touch_sub_info *info = &d->info;
+	int is_flex_report = d->p_param.flex_report;
+	u32 addr = TC_IC_STATUS;
+	char *buf = (char *)&d->info;
+	int intr_type = 0;
+	int size = 0;
+	int pkt_unit = 0;
+	int pkt_cnt = 0;
+	int touch_sub_cnt = 0;
+	int ret = 0;
+
+	pkt_unit = REPORT_PACKET_SIZE;
+	pkt_cnt = REPORT_PACKET_BASE_COUNT;
+	touch_sub_cnt = MAX_FINGER - pkt_cnt;
+
+	size = REPORT_BASE_HDR;
+	size += sizeof(info->pen);
+	size += (pkt_unit * pkt_cnt);
+
+	if(is_flex_report) {
+		ret = sw42902_sub_reg_read(dev, addr, (void *)buf, size);
+		if(ret < 0) {
+			TOUCH_E("Register read fail\n");
+			d->err_cnt++;
+			ret = -EGLOBALRESET;
+			goto error;
+		}
+
+		TOUCH_D(ABS, "Base Read - Addr: %x, ic: %x, tc:%x, Dst: %p, Touch_cnt: %d, Pen_cnt: %d, Size: %d\n",
+				addr, info->ic_status, info->tc_status, info, info->touch_sub_cnt, info->pen_cnt, size);
+
+		if (info->wakeup_type != ABS_MODE) {
+			/* no need to read more */
+			return 0;
+		}
+
+		if ((info->touch_sub_cnt <= pkt_cnt) ||
+			(info->touch_sub_cnt > MAX_FINGER)) {
+			/* no need to read more */
+			return 0;
+		}
+
+		addr += (size>>2);
+		buf += size;
+		size = 0;
+
+		intr_type = sw42902_tc_sts_irq_type(info->tc_status);
+
+		if (intr_type == INTR_TYPE_REPORT_PACKET) {
+			touch_sub_cnt = info->touch_sub_cnt - pkt_cnt;
+		} else {
+			/* debugging */
+			touch_sub_cnt = MAX_FINGER - pkt_cnt;
+		}
+		if (!touch_sub_cnt) {
+			return 0;
+		}
+	}
+
+	size += (pkt_unit * touch_sub_cnt);
+
+	ret = sw42902_sub_reg_read(dev, addr, (void *)buf, size);
+	if(ret < 0) {
+		TOUCH_E("Register read fail\n");
+		d->err_cnt++;
+		ret = -EGLOBALRESET;
+		goto error;
+	}
+
+	if(is_flex_report) {
+		TOUCH_D(ABS, "Extra Read - Addr: %x, Dst: %p, Touch_cnt: %d(%d), Size: %d\n",
+				addr, buf, touch_sub_cnt, info->touch_sub_cnt, size);
+	}
+
+	return ret;
+
+error:
+	if (d->err_cnt > 3) {
+		TOUCH_I("%s : But skip err handling, err_cnt = %d\n", __func__, d->err_cnt);
+		ret = -ERANGE;
+	}
+
+	return ret;
+}
