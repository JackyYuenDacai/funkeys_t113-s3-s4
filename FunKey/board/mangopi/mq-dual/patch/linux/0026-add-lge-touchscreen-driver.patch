+
+	ret = Read8BitRegisters(dev, (F54DataBase + REPORT_DATA_OFFEST), &Data[0], MaxArrayLength);
+	if (ret < 0) {
+		TOUCH_E("failed to read (F54DataBase + REPORT_DATA_OFFEST) - ret:%d\n", ret);
+		return -EAGAIN;
+	}
