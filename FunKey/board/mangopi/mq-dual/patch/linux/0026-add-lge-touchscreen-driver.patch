+		buf[8] = (d->lpwg_longpress.area.y2) >> 8;
+		buf[9] = d->lpwg_longpress.min_press_time;
+		buf[10] = d->lpwg_longpress.min_contact_size;
+		buf[11] = d->lpwg_longpress.touch_slop;
