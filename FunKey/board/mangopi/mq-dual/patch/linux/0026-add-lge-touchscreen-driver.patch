+/* Rawdata compare result
+ * Pass : reurn 0
+ * Fail : return 1
+ */
+static int prd_compare_rawdata(struct device *dev, u8 type, int *result)
+{
+	struct sw42000_data *d = to_sw42000_data(dev);
+	struct siw_hal_prd_data *prd = (struct siw_hal_prd_data *)d->prd;
