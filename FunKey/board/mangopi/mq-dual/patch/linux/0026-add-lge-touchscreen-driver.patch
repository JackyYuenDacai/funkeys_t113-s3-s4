+int s3706_set_page(struct device *dev, u8 page)
+{
+	int ret = s3706_write(dev, PAGE_SELECT_REG, &page, 1);
+
+	if (ret >= 0)
+		to_s3706_data(dev)->curr_page = page;
+
+	return ret;
+}
