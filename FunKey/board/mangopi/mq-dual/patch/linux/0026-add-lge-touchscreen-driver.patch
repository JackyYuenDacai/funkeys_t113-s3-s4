+static void ft8756_lcd_mode(struct device *dev, u32 mode)
+{
+	struct ft8756_data *d = to_ft8756_data(dev);
+
+	d->prev_lcd_mode = d->lcd_mode;
+	d->lcd_mode = mode;
+	TOUCH_D(TRACE, "lcd_mode: %d (prev: %d)\n", d->lcd_mode, d->prev_lcd_mode);
+}
