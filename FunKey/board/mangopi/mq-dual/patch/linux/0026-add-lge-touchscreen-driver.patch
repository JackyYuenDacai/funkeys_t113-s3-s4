+	/*********Step 7: reset the new FW***********************/
+	printk("[Touch][fts] Step 7: reset the new FW\n");
+	auc_i2c_write_buf[0] = 0x07;
+	fts_i2c_write(client, auc_i2c_write_buf, 1);
