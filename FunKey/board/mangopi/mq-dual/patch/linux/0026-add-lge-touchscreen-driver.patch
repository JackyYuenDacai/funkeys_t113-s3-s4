+	}
+
+	/* Test Type Write */
+	TOUCH_I("[PT_INFO_CHECK]\n");
+
+	result_addr = TC_STS + FLASH_INFO_CHECK_RESULT_OFT;
+
+	/* pT Info Check */
+	type = PT_INFO_CHECK;
+	write_test_mode_result = write_test_mode(dev, type);
