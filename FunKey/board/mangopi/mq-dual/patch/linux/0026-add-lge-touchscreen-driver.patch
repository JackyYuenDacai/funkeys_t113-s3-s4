+int s3706_ic_info(struct device *dev)
+{
+	struct s3706_data *d = to_s3706_data(dev);
+
+	int ret = 0;
+	char str[7] = {0};
+
+	TOUCH_TRACE();
+
+	if (atomic_read(&d->state.scan_pdt) == true) {
+		s3706_fwu_init(dev);
