+static int clear_buf(void)
+{
+	int i = 0;
+
+	for (i = 0; i < TRX_MAX; i++) {
+		memset(rawcap_upper[i], 0, sizeof(int) * TRX_MAX);
+		memset(rawcap_lower[i], 0, sizeof(int) * TRX_MAX);
+	}
+
+	memset(hybrid_abs_rx_upper, 0, sizeof(int) * TRX_MAX);
+	memset(hybrid_abs_rx_lower, 0, sizeof(int) * TRX_MAX);
+	memset(hybrid_abs_tx_upper, 0, sizeof(int) * TRX_MAX);
+	memset(hybrid_abs_tx_lower, 0, sizeof(int) * TRX_MAX);
+	memset(trx_short_limit, 0, sizeof(int) * TRX_BITMAP_LENGTH);
+	memset(ext_trx_short_limit, 0, sizeof(int) * 2);
+	jitter_upper = 0;
+	jitter_lower = 0;
+	high_resistance_upper = 0;
+	high_resistance_lower = 0;
+
+	TOUCH_I("buffer clear done.\n");
+	return 0;
+}
