+	case SWIPE_UP:
+		TOUCH_I("SWIPE_UP\n");
+		sw42902_get_swipe_data(dev);
+		ts->intr_status = TOUCH_IRQ_SWIPE_UP;
+		break;
+
+	case SWIPE_DOWN:
