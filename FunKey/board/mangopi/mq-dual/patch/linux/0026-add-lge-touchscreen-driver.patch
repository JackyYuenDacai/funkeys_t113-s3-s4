+			d->touch_info.frame_rate = data;
+			offset += bits;
+			break;
+		case TOUCH_CID_IM:
+			bits = config_data[config_idx];
+			config_idx++;
+			ret = s3618_get_report_data(dev, offset, bits, &data);
+			if (ret < 0) {
+				TOUCH_E("Failed to get CID IM\n");
+				return ret;
