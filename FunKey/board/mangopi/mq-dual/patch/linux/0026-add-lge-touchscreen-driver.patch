+static void s3706_fb_notify_work_func(struct work_struct *fb_notify_work)
+{
+	struct s3706_data *d =
+			container_of(to_delayed_work(fb_notify_work),
+				struct s3706_data, fb_notify_work);
+	int ret = 0;
+
+	if (d->lcd_mode == LCD_MODE_U3)
