+int s3707_init(struct device *dev)
+{
+	struct s3707_data *d = to_s3707_data(dev);
+	struct touch_core_data *ts = to_touch_core(dev);
+
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	if (atomic_read(&d->state.power) == POWER_OFF) {
+		TOUCH_I("%s: d.state->power is POWER_OFF\n", __func__);
+		return 0;
+	}
+
+	ret = s3707_ic_info(dev);
+	if (ret < 0) {
+		TOUCH_E("Failed to get ic info (ret: %d)\n", ret);
+		if (ts->force_fwup == 1) {
+			TOUCH_I("%s : Forcefully trigger f/w Upgrade\n", __func__);
+			touch_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+			ret = s3707_upgrade(dev);
+			if (ret) {
+				TOUCH_E("Failed to f/w upgrade (ret: %d)\n", ret);
+				goto error;
+			}
+			ts->force_fwup = 0;
+			touch_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+			ret = s3707_ic_info(dev);
+			if (ret < 0) {
+				TOUCH_E("Failed to get ic info (ret: %d)\n", ret);
+				goto error;
+			}
+		} else {
+			atomic_set(&d->state.init, IC_INIT_NEED);
+			goto error;
+		}
+	}
+
+	ret = s3707_set_configured(dev);
+	if (ret < 0) {
+		TOUCH_E("failed to set configured (ret: %d)\n", ret);
+		goto error;
+	}
+
+	ret = s3707_rmidev_init(dev);
+	if (ret < 0) {
+		TOUCH_E("failed to rmidev init (ret: %d)\n", ret);
+		goto error;
+	}
+
+	ret = s3707_connect(dev);
+	if (ret < 0) {
+		TOUCH_E("failed to set charger connect (ret: %d)\n", ret);
+		goto error;
+	}
+
+	ret = s3707_ime_status(dev);
+	if (ret < 0) {
+		TOUCH_E("failed to set ime status (ret: %d)\n", ret);
+		goto error;
+	}
+
+	ret = s3707_film_status(dev);
+	if (ret < 0) {
+		TOUCH_E("failed to set film status (ret: %d)\n", ret);
+		goto error;
+	}
+
+	ret = s3707_grip_set(dev);
+	if (ret < 0) {
+		TOUCH_E("failed to set grip status (ret: %d)\n", ret);
+		goto error;
+	}
+
+	atomic_set(&d->state.init, IC_INIT_DONE);
+	atomic_set(&d->state.esd_recovery, ESD_RECOVERY_DONE);
+
+	TOUCH_I("%s: int_pin is %s, enable interrupt", __func__, gpio_get_value(ts->int_pin) ? "HIGH" : "LOW");
+
+	touch_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+
+	ret = s3707_irq_enable(dev, true);
+	if (ret < 0) {
+		TOUCH_E("failed to set irq enable (ret: %d)\n", ret);
+		goto error;
+	}
+
+	ret = s3707_lpwg_mode(dev);
+	if (ret < 0)
+		TOUCH_E("failed to set lpwg mode (ret: %d)\n", ret);
+
+	TOUCH_I("Irq clear check after all setting\n");
+	ret = s3707_irq_clear(dev);
+	if (ret < 0) {
+		TOUCH_E("failed to set irq clear (ret: %d)\n", ret);
+		goto error;
+	}
+
+error:
+	return ret;
+}
+
+static int s3707_shutdown(struct device *dev)
+{
+	struct s3707_data *d = to_s3707_data(dev);
+
+	TOUCH_TRACE();
+
+	s3707_power(dev, POWER_OFF);
+	pm_qos_remove_request(&d->pm_qos_req);
+
+	return 0;
+}
+
+static int s3707_probe(struct device *dev)
+{
+	struct touch_core_data *ts = to_touch_core(dev);
+	struct s3707_data *d = NULL;
+
+	TOUCH_TRACE();
+
+	d = devm_kzalloc(dev, sizeof(*d), GFP_KERNEL);
+
+	if (!d) {
+		TOUCH_E("failed to allocate s3707 data\n");
+		return -ENOMEM;
+	}
+
+	touch_set_device(ts, d);
+
+	touch_gpio_init(ts->reset_pin, "touch_reset");
+	touch_gpio_direction_output(ts->reset_pin, 0);
+
+	touch_gpio_init(ts->int_pin, "touch_int");
+	touch_gpio_direction_input(ts->int_pin);
+
+	touch_power_init(dev);
+	touch_bus_init(dev, MAX_BUF_SIZE);
+
+	s3707_init_works(dev);
+
+	s3707_init_tci_info(dev);
+	s3707_init_swipe_info(dev);
+	s3707_init_lpwg_abs_info(dev);
+	s3707_init_ai_pick_info(dev);
+	pm_qos_add_request(&d->pm_qos_req, PM_QOS_CPU_DMA_LATENCY, PM_QOS_DEFAULT_VALUE);
+
+	atomic_set(&d->state.scan_pdt, true);
+	d->ic_info.fw_pid_addr = 0x98;
+	d->ic_info.fw_ver_addr = 0x150;
+	d->lpwg_fail_reason = 0;
+	d->noise.noise_log = NOISE_ENABLE;
+	d->check_fwup = UPGRADE_NOT_INITAILIZED;
+
+	d->lcd_mode = LCD_MODE_U3;
+	atomic_set(&d->state.grip_status, GRIP_SUPPRESSION_ENABLE);
+
+	if (is_ddic_name("rm69299a") || is_ddic_name("rm69299b")) {
+		TOUCH_I("%s: change max_x, max_y for DD panel.\n", __func__);
+		ts->caps.max_x = 1079;
+		ts->caps.max_y = 2159;
+	}
+
+	return 0;
+}
+
+static struct touch_driver touch_driver = {
+	.probe = s3707_probe,
+	.remove = s3707_remove,
+	.shutdown = s3707_shutdown,
+	.suspend = s3707_suspend,
+	.resume = s3707_resume,
+	.init = s3707_init,
+	.upgrade = s3707_upgrade,
+	.irq_handler = s3707_irq_handler,
+	.power = s3707_power,
+	.lpwg = s3707_lpwg,
+	.notify = s3707_notify,
+	.init_pm = s3707_init_pm,
+	.esd_recovery = s3707_esd_recovery,
+	.swipe_enable = s3707_swipe_enable,
+	.register_sysfs = s3707_register_sysfs,
+	.set = s3707_set,
+	.get = s3707_get,
+};
+
+#define MATCH_NAME			"synaptics,s3707"
+
+static const struct of_device_id touch_match_ids[] = {
+	{ .compatible = MATCH_NAME, },
+	{},
+};
+
+static struct touch_hwif hwif = {
+	.bus_type = HWIF_I2C,
+	.name = LGE_TOUCH_NAME,
+	.owner = THIS_MODULE,
+	.of_match_table = of_match_ptr(touch_match_ids),
+};
+
+static int __init touch_device_init(void)
+{
+	TOUCH_TRACE();
+
+	if (!(is_ddic_name("sw43410") || is_ddic_name("sw43408a")
+				|| is_ddic_name("rm69299a") || is_ddic_name("rm69299b"))) {
+		TOUCH_I("%s, s3707 not found.\n", __func__);
+		return 0;
+	}
+	if (is_ddic_name("sw43408a"))
+		TOUCH_I("%s, sw43408a s3707 detected\n", __func__);
+	else if (is_ddic_name("rm69299a"))
+		TOUCH_I("%s, rm69299a Tianma s3706 detected\n", __func__);
+	else if (is_ddic_name("rm69299b"))
+		TOUCH_I("%s, rm69299b Tovis s3706 detectec\n", __func__);
+
+	return touch_bus_device_init(&hwif, &touch_driver);
+}
+
+static void __exit touch_device_exit(void)
+{
+	TOUCH_TRACE();
+	touch_bus_device_exit(&hwif);
+}
+
+module_init(touch_device_init);
+module_exit(touch_device_exit);
+
+MODULE_AUTHOR("BSP-TOUCH@lge.com");
+MODULE_DESCRIPTION("LGE touch driver v5");
+MODULE_LICENSE("GPL");
