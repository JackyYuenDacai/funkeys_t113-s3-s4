+
+/*
+ *  Include to touch core Header File
+ */
+#include <touch_sub_core.h>
+#include <touch_sub_i2c.h>
+#include <touch_sub_spi.h>
+#include <touch_sub_hwif.h>
+
+/* -- gpio -- */
+int touch_sub_gpio_init(int pin, const char *name)
+{
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	TOUCH_I("%s - pin:%d, name:%s\n", __func__, pin, name);
+
+	if (gpio_is_valid(pin))
+		ret = gpio_request(pin, name);
+
+	return ret;
+}
+
+int touch_sub_gpio_direction_input(int pin)
+{
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	TOUCH_I("%s - pin:%d\n", __func__, pin);
+
+	if (gpio_is_valid(pin))
+		ret = gpio_direction_input(pin);
+
+	return ret;
+}
+
+int touch_sub_gpio_direction_output(int pin, int value)
+{
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	TOUCH_I("%s - pin:%d, value:%d\n", __func__, pin, value);
+
+	if (gpio_is_valid(pin))
+		ret = gpio_direction_output(pin, value);
+
+	return ret;
+}
+
+/* -- power -- */
+int touch_sub_power_init(struct device *dev)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	if (gpio_is_valid(ts->vcl_pin)) {
+		ret = gpio_request(ts->vcl_pin, "touch-vcl");
+	} else {
+		TOUCH_I("%s vcl - id: %d, vol: %d\n", __func__,
+				ts->vcl_id, ts->vcl_vol);
+	}
+
+	if (gpio_is_valid(ts->vdd_pin)) {
+		ret = gpio_request(ts->vdd_pin, "touch-vdd");
+	} else {
+		TOUCH_I("%s vdd - id: %d, vol: %d\n", __func__,
+				ts->vdd_id, ts->vdd_vol);
+	}
+
+	return ret;
+}
+
+void touch_sub_power_3_3_vcl(struct device *dev, int value)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+
+	TOUCH_TRACE();
+
+	if (gpio_is_valid(ts->vcl_pin)) {
+		touch_sub_gpio_direction_output(ts->vcl_pin, value);
+	} else if (ts->vcl_id >= 0) {
+		TOUCH_I("%s vcl - id: %d, vol: %d\n", __func__,
+				ts->vcl_id, ts->vcl_vol);
+		if (value)
+			hwPowerOn(ts->vcl_id, ts->vcl_vol, "TP");
+		else
+			hwPowerDown(ts->vcl_id, "TP");
+	}
+}
+
+void touch_sub_power_1_8_vdd(struct device *dev, int value)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+
+	TOUCH_TRACE();
+
+	if (gpio_is_valid(ts->vdd_pin)) {
+		touch_sub_gpio_direction_output(ts->vdd_pin, value);
+	} else if (ts->vdd_id >= 0) {
+		TOUCH_I("%s vdd - id: %d, vol: %d\n", __func__,
+				ts->vdd_id, ts->vdd_vol);
+		if (value)
+			hwPowerOn(ts->vdd_id, ts->vdd_vol, "TP");
+		else
+			hwPowerDown(ts->vdd_id, "TP");
+	}
+
+}
+
+int touch_sub_bus_init(struct device *dev, int buf_size)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	if (buf_size) {
+		ts->tx_buf = (u8 *)dma_alloc_coherent(NULL,
+				buf_size, (dma_addr_t *)(long)&ts->tx_pa, GFP_KERNEL);
+
+		if (!ts->tx_buf)
+			TOUCH_E("fail to allocate tx_buf\n");
+
+		ts->rx_buf = (u8 *)dma_alloc_coherent(NULL,
+				buf_size, (dma_addr_t *)(long)&ts->rx_pa, GFP_KERNEL);
+		if (!ts->rx_buf)
+			TOUCH_E("fail to allocate rx_buf\n");
+
+#ifdef CONFIG_PHYS_ADDR_T_64BIT
+		TOUCH_I("tx_buf:%p, dma[pa:%08llx]\n",
+				ts->tx_buf, ts->tx_pa);
+		TOUCH_I("rx_buf:%p, dma[pa:%08llx]\n",
+				ts->rx_buf, ts->rx_pa);
+#else
+		TOUCH_I("tx_buf:%p, dma[pa:%08x]\n",
+				ts->tx_buf, ts->tx_pa);
+		TOUCH_I("rx_buf:%p, dma[pa:%08x]\n",
+				ts->rx_buf, ts->rx_pa);
+#endif
+	}
+
+	ts->pinctrl.ctrl = devm_pinctrl_get(dev);
+
+	if (IS_ERR_OR_NULL(ts->pinctrl.ctrl)) {
+		if (PTR_ERR(ts->pinctrl.ctrl) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+
+		TOUCH_I("Target does not use pinctrl\n");
+		ts->pinctrl.ctrl = NULL;
+	} else {
+		ts->pinctrl.active = pinctrl_lookup_state(ts->pinctrl.ctrl,
+				"touch_sub_pin_active");
+
+		if (IS_ERR_OR_NULL(ts->pinctrl.active))
+			TOUCH_E("cannot get pinctrl.active\n");
+
+		ts->pinctrl.suspend = pinctrl_lookup_state(ts->pinctrl.ctrl,
+				"touch_sub_pin_sleep");
+
+		if (IS_ERR_OR_NULL(ts->pinctrl.suspend))
+			TOUCH_E("cannot get pinctrl.suspend\n");
+
+		if (!IS_ERR_OR_NULL(ts->pinctrl.active)) {
+			ret = pinctrl_select_state(ts->pinctrl.ctrl,
+					ts->pinctrl.active);
+			if (ret)
+				TOUCH_I("cannot set pinctrl.active\n");
+			else
+				TOUCH_I("pinctrl set active\n");
+		}
+	}
+	if (ts->bus_type == HWIF_SPI) {
+		ret = spi_setup(to_spi_device(dev));
+
+		if (ret < 0) {
+			TOUCH_E("Failed to perform SPI setup\n");
+			return -ENODEV;
+		}
+	}
+
+	return ret;
+}
+
+int touch_sub_bus_read(struct device *dev, struct touch_sub_bus_msg *msg)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int ret = 0;
+
+	if (ts->bus_type == HWIF_I2C)
+		ret = touch_sub_i2c_read(to_i2c_client(dev), msg);
+	else if (ts->bus_type == HWIF_SPI) {
+		if (atomic_read(&ts->state.pm) >= DEV_PM_SUSPEND) {
+			TOUCH_E("bus_read when pm_suspend");
+			return -EDEADLK;
+		}
+		ret = touch_sub_spi_read(to_spi_device(dev), msg);
+	}
+
+	return ret;
+}
+
+int touch_sub_bus_write(struct device *dev, struct touch_sub_bus_msg *msg)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+	int ret = 0;
+
+	if (ts->bus_type == HWIF_I2C)
+		ret = touch_sub_i2c_write(to_i2c_client(dev), msg);
+	else if (ts->bus_type == HWIF_SPI) {
+		if (atomic_read(&ts->state.pm) >= DEV_PM_SUSPEND) {
+			TOUCH_E("bus_write when pm_suspend");
+			return -EDEADLK;
+		}
+		ret = touch_sub_spi_write(to_spi_device(dev), msg);
+	}
+
+	return ret;
+}
+
+struct touch_sub_core_data *touch_sub_ts;
+
+void touch_sub_enable_irq_wake(unsigned int irq)
+{
+}
+
+void touch_sub_disable_irq_wake(unsigned int irq)
+{
+}
+
+#define istate core_internal_state__do_not_mess_with_it
+void touch_sub_enable_irq(unsigned int irq)
+{
+	struct irq_desc *desc = irq_to_desc(irq);
+
+	TOUCH_TRACE();
+
+	if (desc) {
+		if (desc->irq_data.chip->irq_unmask)
+			desc->irq_data.chip->irq_unmask(&desc->irq_data);
+
+		if (desc->istate & 0x00000200 /*IRQS_PENDING*/)
+			TOUCH_D(BASE_INFO, "Remove pending irq(%d)\n", irq);
+		desc->istate &= ~(0x00000200);
+	}
+	enable_irq(irq);
+}
+
+void touch_sub_disable_irq(unsigned int irq)
+{
+	struct irq_desc *desc = irq_to_desc(irq);
+
+	TOUCH_TRACE();
+	disable_irq_nosync(irq);
+
+	if (desc) {
+		if (desc->irq_data.chip->irq_mask)
+			desc->irq_data.chip->irq_mask(&desc->irq_data);
+	}
+}
+
+int touch_sub_request_irq(unsigned int irq, irq_handler_t handler,
+		     irq_handler_t thread_fn,
+		     unsigned long flags, const char *name, void *dev)
+{
+	TOUCH_TRACE();
+	return request_threaded_irq(irq, handler, thread_fn, flags, name, dev);
+}
+
+void touch_sub_set_irq_pending(unsigned int irq)
+{
+	TOUCH_D(BASE_INFO, "%s is not supported!\n", __func__);
+}
+
+void touch_sub_resend_irq(unsigned int irq)
+{
+	TOUCH_D(BASE_INFO, "%s is not supported!\n", __func__);
+}
+
+int touch_sub_check_boot_mode(struct device *dev)
+{
+	int ret = TOUCH_NORMAL_BOOT;
+	unsigned int boot_mode = 0;
+	bool factory_boot = false;
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+
+	TOUCH_TRACE();
+
+	/* 15 == CHARGERLOGO_BOOT, 110 == LAF_BOOT, defined only in LK   */
+	boot_mode = get_boot_mode();
+	if (boot_mode == 110) {
+		ret = TOUCH_LAF_MODE;
+		return ret;
+	} else if (boot_mode == RECOVERY_BOOT) {
+		ret = TOUCH_RECOVERY_MODE;
+		return ret;
+#if defined(CONFIG_LGE_PM_CHARGERLOGO)
+	} else if (boot_mode == CHARGER_BOOT) {
+		ret = TOUCH_CHARGER_MODE;
+		return ret;
+#endif
+	}
+
+	if (lge_get_boot_mode() == LGE_BOOT_MODE_CHARGERLOGO) {
+		ret = TOUCH_CHARGER_MODE;
+		return ret;
+	}
+
+	factory_boot = lge_get_factory_boot();
+
+	if (factory_boot) {
+		switch (atomic_read(&ts->state.mfts)) {
+		case MFTS_NONE:
+			ret = TOUCH_MINIOS_AAT;
+			break;
+		case MFTS_FOLDER:
+			ret = TOUCH_MINIOS_MFTS_FOLDER;
+			break;
+		case MFTS_FLAT:
+			ret = TOUCH_MINIOS_MFTS_FLAT;
+			break;
+		case MFTS_CURVED:
+			ret = TOUCH_MINIOS_MFTS_CURVED;
+			break;
+		default:
+			ret = TOUCH_MINIOS_AAT;
+			break;
+		}
+	}
+
+	return ret;
+}
+
+int touch_sub_bus_xfer(struct device *dev, struct touch_sub_xfer_msg *xfer)
+{
+	TOUCH_D(BASE_INFO, "%s is not supported!\n", __func__);
+	return 0;
+}
+
+static struct i2c_board_info touch_sub_i2c_board_info __initdata;
+static struct spi_board_info touch_sub_spi_board_info __initdata;
+
+int __init touch_sub_bus_device_init(struct touch_sub_hwif *hwif, void *driver)
+{
+	TOUCH_TRACE();
+
+	if (hwif->bus_type == HWIF_I2C) {
+		struct i2c_board_info board_info = {
+			I2C_BOARD_INFO(LGE_TOUCH_SUB_NAME, 0x28)
+		};
+
+		touch_sub_i2c_board_info = board_info;
+		i2c_register_board_info(0 /*touch_sub_i2c_bus_num*/,
+				&touch_sub_i2c_board_info, 1);
+		return touch_sub_i2c_device_init(hwif, driver);
+	} else if (hwif->bus_type == HWIF_SPI) {
+		struct spi_board_info board_info = {
+			.modalias = LGE_TOUCH_SUB_NAME,
+			/*
+			 * TODO
+			.bus_num = touch_sub_spi_bus_num,
+			*/
+		};
+
+		touch_sub_spi_board_info = board_info;
+		spi_register_board_info(&touch_sub_spi_board_info, 1);
+		return touch_sub_spi_device_init(hwif, driver);
+	}
+
+	TOUCH_E("Unknown touch interface : %d\n", hwif->bus_type);
+
+	return -ENODEV;
+}
+
+void touch_sub_bus_device_exit(struct touch_sub_hwif *hwif)
+{
+	TOUCH_TRACE();
+
+	if (hwif->bus_type == HWIF_I2C)
+		touch_sub_i2c_device_exit(hwif);
+	else if (hwif->bus_type == HWIF_SPI)
+		touch_sub_spi_device_exit(hwif);
+}
diff --git a/drivers/input/touchscreen/lge_sub/touch_sub_i2c.c b/drivers/input/touchscreen/lge_sub/touch_sub_i2c.c
new file mode 100644
index 000000000..bf2ed8213
--- /dev/null
+++ b/drivers/input/touchscreen/lge_sub/touch_sub_i2c.c
@@ -0,0 +1,444 @@
+/*
+ * touch_sub_i2c.c
+ *
+ * Copyright (c) 2015 LGE.
+ *
+ * author : hoyeon.jang@lge.com
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ */
+
+#include <linux/kernel.h>
+#include <linux/platform_device.h>
+#include <linux/i2c.h>
+#include <linux/delay.h>
+
+/*
+ *  Include to touch core Header File
+ */
+#include <touch_sub_core.h>
+#include <touch_sub_hwif.h>
+#include <touch_sub_i2c.h>
+
+int touch_sub_i2c_read(struct i2c_client *client, struct touch_sub_bus_msg *msg)
+{
+	int ret;
+#if defined(CONFIG_LGE_TOUCH_CORE_MTK)
+	int retry = 0;
+#endif
+	struct i2c_msg msgs[] = {
+		{
+			.addr = client->addr,
+			.flags = 0,
+			.len = msg->tx_size,
+			.buf = msg->tx_buf,
+		},
+		{
+			.addr = client->addr,
+			.flags = I2C_M_RD,
+			.len = msg->rx_size,
+			.buf = msg->rx_buf,
+		},
+	};
+#ifdef USE_I2C_MTK_EXT
+	{
+		struct touch_sub_core_data *ts =
+			(struct touch_sub_core_data *) i2c_get_clientdata(client);
+		if (ts->tx_pa) {
+			msgs[0].addr &= I2C_MASK_FLAG;
+			msgs[0].addr |= I2C_ENEXT_FLAG;
+			msgs[0].timing = 400;
+
+			if (msgs[0].len >= 8) {
+				msgs[0].addr |= I2C_DMA_FLAG;
+				msgs[0].buf = (u8 *)(long)ts->tx_pa;
+			}
+		}
+
+		if (ts->rx_pa) {
+			msgs[1].addr &= I2C_MASK_FLAG;
+			msgs[1].addr |= I2C_ENEXT_FLAG;
+			msgs[1].timing = 400;
+
+			if (msgs[1].len >= 8) {
+				msgs[1].addr |= I2C_DMA_FLAG;
+				msgs[1].buf = (u8 *)(long)ts->rx_pa;
+			}
+		}
+	}
+#elif defined(CONFIG_MTK_I2C_EXTENSION)
+	{
+		struct touch_sub_core_data *ts =
+			(struct touch_sub_core_data *) i2c_get_clientdata(client);
+		if (ts->tx_pa) {
+			msgs[0].addr &= I2C_MASK_FLAG;
+			msgs[0].timing = 400;
+			msgs[0].ext_flag = client->ext_flag | I2C_ENEXT_FLAG | I2C_DMA_FLAG;
+			msgs[0].buf = (u8 *)(long)ts->tx_pa;
+		}
+		if (ts->rx_pa) {
+			msgs[1].addr &= I2C_MASK_FLAG;
+			msgs[1].timing = 400;
+			msgs[1].ext_flag = client->ext_flag | I2C_ENEXT_FLAG | I2C_DMA_FLAG;
+			msgs[1].buf = (u8 *)(long)ts->rx_pa;
+		}
+	}
+#endif
+
+	if (msg->rx_size > MAX_BUF_SIZE || msg->tx_size > MAX_BUF_SIZE) {
+		TOUCH_E("buffer overflow\n");
+		return -ENOMEM;
+	}
+
+#if defined(CONFIG_LGE_TOUCH_CORE_MTK)
+	do {
+		ret = i2c_transfer(client->adapter, &msgs[0], 1);
+		ret += i2c_transfer(client->adapter, &msgs[1], 1);
+
+		if (ret < 0) {
+			TOUCH_E("touch i2c error! retry [%d] ret = %d\n", retry + 1, ret);
+			touch_sub_msleep(20);
+		} else {
+			break;
+		}
+
+	} while (++retry < 3);
+#elif defined(CONFIG_LGE_TOUCH_CORE_QCT)
+	ret = i2c_transfer(client->adapter, &msgs[0], 1);
+	ret += i2c_transfer(client->adapter, &msgs[1], 1);
+
+	if (ret == ARRAY_SIZE(msgs)) {
+		return 0;
+	} else if (ret < 0) {
+		TOUCH_E("i2c_transfer - errno[%d]\n", ret);
+	} else if (ret != ARRAY_SIZE(msgs)) {
+		TOUCH_E("i2c_transfer - size[%d] result[%d]\n",
+				(int) ARRAY_SIZE(msgs), ret);
+	} else {
+		TOUCH_E("unknown error [%d]\n", ret);
+	}
+#endif
+
+	return ret;
+
+}
+
+int touch_sub_i2c_write(struct i2c_client *client, struct touch_sub_bus_msg *msg)
+{
+	int ret;
+#if defined(CONFIG_LGE_TOUCH_CORE_MTK)
+	int retry = 0;
+#endif
+	struct i2c_msg msgs[] = {
+		{
+			.addr = client->addr,
+			.flags = 0,
+			.len = msg->tx_size,
+			.buf = msg->tx_buf,
+		},
+	};
+
+#ifdef USE_I2C_MTK_EXT
+	{
+		struct touch_sub_core_data *ts =
+			(struct touch_sub_core_data *) i2c_get_clientdata(client);
+		if (ts->tx_pa) {
+			msgs[0].addr &= I2C_MASK_FLAG;
+			msgs[0].addr |= I2C_ENEXT_FLAG;
+			msgs[0].timing = 400;
+
+			if (msgs[0].len >= 8) {
+				msgs[0].addr |= I2C_DMA_FLAG;
+				msgs[0].buf = (u8 *)(long)ts->tx_pa;
+			}
+		}
+	}
+#elif defined(CONFIG_MTK_I2C_EXTENSION)
+	{
+		struct touch_sub_core_data *ts =
+			(struct touch_sub_core_data *) i2c_get_clientdata(client);
+		if (ts->tx_pa) {
+			msgs[0].addr &= I2C_MASK_FLAG;
+			msgs[0].timing = 400;
+			msgs[0].ext_flag = client->ext_flag | I2C_ENEXT_FLAG | I2C_DMA_FLAG;
+			msgs[0].buf = (u8 *)(long)ts->tx_pa;
+		}
+	}
+#endif
+
+	if (msg->tx_size > MAX_BUF_SIZE) {
+		TOUCH_E("buffer overflow\n");
+		return -ENOMEM;
+	}
+
+#if defined(CONFIG_LGE_TOUCH_CORE_MTK)
+	do {
+		ret = i2c_transfer(client->adapter, msgs, 1);
+
+		if (ret < 0) {
+			TOUCH_E("touch i2c error! retry [%d] ret = %d\n", retry + 1, ret);
+			touch_sub_msleep(20);
+		} else {
+			break;
+		}
+
+	} while (++retry < 3);
+#elif defined(CONFIG_LGE_TOUCH_CORE_QCT)
+	ret = i2c_transfer(client->adapter, msgs, 1);
+#endif
+
+	return ret;
+}
+
+static void touch_sub_i2c_release(struct device *dev)
+{
+	if (dev->platform_data)
+		dev->platform_data = NULL;
+}
+
+struct touch_sub_bus_info {
+	struct i2c_driver bus_driver;
+	struct touch_sub_hwif *hwif;
+	struct touch_sub_driver *touch_sub_driver;
+};
+
+static int touch_sub_i2c_probe(struct i2c_client *i2c,
+		const struct i2c_device_id *id)
+{
+	struct touch_sub_bus_info *info =
+		container_of(to_i2c_driver(i2c->dev.driver),
+			struct touch_sub_bus_info, bus_driver);
+
+	struct platform_device *pdev;
+	struct touch_sub_core_data *ts;
+	int ret = 0;
+
+	TOUCH_TRACE();
+
+	TOUCH_I("i2c slave address : %x\n", i2c->addr);
+
+	if (!i2c_check_functionality(i2c->adapter, I2C_FUNC_I2C))
+		return -ENODEV;
+
+	TOUCH_I("%s\n, platform ptr = %p\n",
+			__func__, i2c->dev.platform_data);
+
+	if (!info) {
+		TOUCH_E("info is NULL\n");
+		return -ENOMEM;
+	}
+
+	ts = devm_kzalloc(&i2c->dev, sizeof(*ts), GFP_KERNEL);
+
+	if (!ts) {
+		TOUCH_E("Failed to allocate memory for touch_sub_core_data\n");
+		return -ENOMEM;
+	}
+
+	ts->bus_type = info->hwif->bus_type;
+	ts->dev = &i2c->dev;
+	ts->irq = i2c->irq;
+	ts->driver = info->touch_sub_driver;
+	ts->touch_sub_ic_name = info->hwif->of_match_table->compatible;
+
+	dev_set_drvdata(&i2c->dev, ts);
+
+	pdev = devm_kzalloc(&i2c->dev, sizeof(*pdev), GFP_KERNEL);
+
+	if (!pdev) {
+		TOUCH_E("Failed to allocate memory for touch platform_devce\n");
+		return -ENOMEM;
+	}
+
+	ts->pdev = pdev;
+
+	pdev->name = LGE_TOUCH_SUB_DRIVER_NAME;
+	pdev->id = 0;
+	pdev->num_resources = 0;
+	pdev->dev.parent = &i2c->dev;
+	pdev->dev.platform_data = ts;
+	pdev->dev.release = touch_sub_i2c_release;
+
+	TOUCH_I("platform device register\n");
+	ret = platform_device_register(pdev);
+
+	if (ret) {
+		TOUCH_E("Failed to allocate memory for touch platform_devce\n");
+		return -ENODEV;
+	}
+	TOUCH_I("platform device registered ...\n");
+
+#if defined(CONFIG_SUB_SECURE_TOUCH)
+	secure_touch_sub_init(ts);
+	secure_touch_sub_stop(ts, true);
+#endif
+
+	return 0;
+}
+
+static int touch_sub_i2c_remove(struct i2c_client *i2c)
+{
+	TOUCH_TRACE();
+	return 0;
+}
+
+static int touch_sub_i2c_pm_suspend(struct device *dev)
+{
+#if defined(CONFIG_LGE_TOUCH_CORE_QCT)
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+
+	TOUCH_TRACE();
+
+	atomic_set(&ts->state.pm, DEV_PM_SUSPEND);
+#endif
+
+	TOUCH_I("%s : DEV_PM_SUSPEND\n", __func__);
+
+	return 0;
+}
+
+static int touch_sub_i2c_pm_resume(struct device *dev)
+{
+	struct touch_sub_core_data *ts = to_touch_sub_core(dev);
+
+	TOUCH_TRACE();
+
+	if (atomic_read(&ts->state.pm) == DEV_PM_SUSPEND_IRQ) {
+		atomic_set(&ts->state.pm, DEV_PM_RESUME);
+		TOUCH_I("%s : DEV_PM_RESUME\n", __func__);
+		touch_sub_set_irq_pending(ts->irq);
+		touch_sub_resend_irq(ts->irq);
+		return 0;
+	}
+
+	atomic_set(&ts->state.pm, DEV_PM_RESUME);
+	TOUCH_I("%s : DEV_PM_RESUME\n", __func__);
+	return 0;
+}
+
+static const struct dev_pm_ops touch_sub_pm_ops = {
+	.suspend = touch_sub_i2c_pm_suspend,
+	.resume = touch_sub_i2c_pm_resume,
+};
+
+static struct i2c_device_id touch_sub_id[] = {
+	{ LGE_TOUCH_SUB_NAME, 0 },
+	{},
+};
+
+#if defined(CONFIG_SUB_SECURE_TOUCH)
+static int touch_sub_clk_prepare_enable(struct touch_sub_core_data *ts)
+{
+	int ret;
+
+	ret = clk_prepare_enable(ts->iface_clk);
+	if (ret) {
+		dev_err(ts->pdev->dev.parent,
+				"error on clk_prepare_enable(iface_clk):%d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(ts->core_clk);
+	if (ret) {
+		clk_disable_unprepare(ts->iface_clk);
+		dev_err(ts->pdev->dev.parent,
+				"error clk_prepare_enable(core_clk):%d\n", ret);
+	}
+	return ret;
+}
+
+static void touch_sub_clk_disable_unprepare(struct touch_sub_core_data *ts)
+{
+	clk_disable_unprepare(ts->core_clk);
+	clk_disable_unprepare(ts->iface_clk);
+}
+
+int touch_sub_i2c_get(struct touch_sub_core_data *ts)
+{
+	int retval;
+	struct i2c_client *i2c = to_i2c_client(ts->pdev->dev.parent);
+
+	TOUCH_TRACE();
+
+	mutex_lock(&ts->touch_sub_io_ctrl_mutex);
+	retval = pm_runtime_get_sync(i2c->adapter->dev.parent);
+	if (retval >= 0 && ts->core_clk != NULL &&
+			ts->iface_clk != NULL) {
+		retval = touch_sub_clk_prepare_enable(ts);
+		if (retval)
+			pm_runtime_put_sync(i2c->adapter->dev.parent);
+	} else {
+		TOUCH_I("clk null, do not ctrl clk\n");
+	}
+
+	mutex_unlock(&ts->touch_sub_io_ctrl_mutex);
+
+	return retval;
+}
+
+void touch_sub_i2c_set(struct touch_sub_core_data *ts)
+{
+	struct i2c_client *i2c = to_i2c_client(ts->pdev->dev.parent);
+
+	TOUCH_TRACE();
+
+	mutex_lock(&ts->touch_sub_io_ctrl_mutex);
+	if (ts->core_clk != NULL && ts->iface_clk != NULL)
+		touch_sub_clk_disable_unprepare(ts);
+	else
+		TOUCH_I("clk null, do not ctrl clk\n");
+
+	pm_runtime_put_sync(i2c->adapter->dev.parent);
+	mutex_unlock(&ts->touch_sub_io_ctrl_mutex);
+}
+#endif
+
+int touch_sub_i2c_device_init(struct touch_sub_hwif *hwif, void *driver)
+{
+	struct touch_sub_bus_info *info;
+
+	info = kzalloc(sizeof(*info), GFP_KERNEL);
+
+	TOUCH_TRACE();
+
+	if (!info) {
+		TOUCH_E("faied to allocate i2c_driver\n");
+		return -ENOMEM;
+	}
+
+	hwif->info = info;
+
+	info->bus_driver.driver.name = hwif->name;
+	info->bus_driver.driver.owner = hwif->owner;
+	info->bus_driver.driver.of_match_table = hwif->of_match_table;
+	info->bus_driver.driver.pm = &touch_sub_pm_ops;
+
+	info->bus_driver.probe = touch_sub_i2c_probe;
+	info->bus_driver.remove = touch_sub_i2c_remove;
+	info->bus_driver.id_table = touch_sub_id;
+
+	info->hwif = hwif;
+	info->touch_sub_driver = driver;
+	TOUCH_I("touch_sub compatible:%s \n", info->bus_driver.driver.of_match_table->compatible);
+	return i2c_register_driver(info->hwif->owner, &info->bus_driver);
+}
+
+void touch_sub_i2c_device_exit(struct touch_sub_hwif *hwif)
+{
+	struct touch_sub_bus_info *info = (struct touch_sub_bus_info *) hwif->info;
+
+	TOUCH_TRACE();
+
+	if (info) {
+		kfree(info);
+		hwif->info = NULL;
+	}
+}
