+static void s3707_grip_status(struct device *dev, u32 *data)
+{
+	struct s3707_data *d = to_s3707_data(dev);
+	int grip_status = *data;
+
+	if (grip_status)
+		atomic_set(&d->state.grip_status, GRIP_SUPPRESSION_ENABLE);
+	else
+		atomic_set(&d->state.grip_status, GRIP_SUPPRESSION_DISABLE);
+}
+
+static int s3707_grip_set(struct device *dev)
+{
+	struct s3707_data *d = to_s3707_data(dev);
+	int ret = 0;
+	int data = atomic_read(&d->state.grip_status);
+	int dd_state = atomic_read(&d->state.dd_status);
+	u8 buffer = 0;
+
+	TOUCH_TRACE();
+
+	ret = s3707_set_page(dev, LPWG_PAGE);
+	if (ret < 0) {
+		TOUCH_E("failed to set LPWG_PAGE (ret = %d)\n", ret);
+		goto error;
+	}
+
+	ret = s3707_read(dev, GRIP_SUPPRESSION_CTRL_REG, &buffer, sizeof(buffer));
+	if (ret < 0) {
+		TOUCH_E("failed to read grip suppression control reg - ret:%d\n", ret);
+		goto error;
+	}
+
+	if (data)
+		buffer |= 0x01;
+	else
+		buffer &= 0xfe;
+
+	if (dd_state)
+		buffer |= 0x04;
+	else
+		buffer &= 0xfb;
+
+	ret = s3707_write(dev, GRIP_SUPPRESSION_CTRL_REG, &buffer, sizeof(buffer));
+	if (ret < 0) {
+		TOUCH_E("failed to write grip suppression control reg - ret:%d\n", ret);
+		goto error;
+	}
+
+	TOUCH_I("%s: grip suppression %s\n", __func__,
+			data ? "enable" : "disable");
+
+error:
+	ret = s3707_set_page(dev, DEFAULT_PAGE);
+	if (ret < 0)
+		TOUCH_E("failed to set DEFAUT_PAGE (ret: %d)\n", ret);
+
+	return ret;
+}
