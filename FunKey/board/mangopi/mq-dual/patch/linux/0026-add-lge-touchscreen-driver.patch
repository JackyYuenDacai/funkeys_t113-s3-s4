+static int sw42902_swivel_status(struct device *dev, u32 state)
+{
+	struct touch_core_data *ts = to_touch_core(dev);
+	int boot_mode = 0;
+	int cur_status = atomic_read(&ts->state.swivel);
+
+	TOUCH_TRACE();
+	TOUCH_I("Swivel State: %d\n", atomic_read(&ts->state.swivel));
+
+	boot_mode = touch_check_boot_mode(dev);
+	if(boot_mode == TOUCH_NORMAL_BOOT)
+	{
+		if (cur_status == SWIVEL_HALF)
+		{
+			TOUCH_I("%s : HALF SWIVEL!!!! INTERRUPT DISABLE!!!",__func__);
+			touch_report_all_event(ts);
+			touch_interrupt_control(ts->dev, INTERRUPT_DISABLE);
+		}
+		else
+		{
+			if(atomic_read(&ts->state.sleep) != IC_DEEP_SLEEP)
+			{
+				TOUCH_I("%s : Swivel change complete!!!! INTERRUPT Enable",__func__);
+				touch_interrupt_control(ts->dev, INTERRUPT_ENABLE);
+			}
+			else
+			{
+				TOUCH_I("%s :  deep sleep status!!!! skip interrupt control!!",__func__);
+			}
+		}
+	}
+	return 0;
+}
