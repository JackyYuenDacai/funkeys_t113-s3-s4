+	rmidev_sysfs_irq_enable(rmidev->ts_dev, true);
+	TOUCH_I("%s: rmidev_sysfs_irq_enable error!\n", __func__);
+
+	TOUCH_I("%s: Attention interrupt disabled\n", __func__);
