index 000000000..9979b4950
--- /dev/null
+++ b/drivers/input/touchscreen/lge/lgsic/sw42902_wing/touch_sw42902_abt.c
@@ -0,0 +1,437 @@
+/* touch_sw42902_abt.c
+ *
+ * Copyright (C) 2015 LGE.
