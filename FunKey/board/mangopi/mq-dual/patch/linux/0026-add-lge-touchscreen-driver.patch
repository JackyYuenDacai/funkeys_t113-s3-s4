+static void hx83113a_power_on_init(struct device *dev)
+{
+	uint8_t tmp_data[DATA_LEN_4];
+	int i = 0;
+
+	for (i = 0; i < ADDR_LEN_4; i++) {
+		tmp_data[i] = (uint8_t)(FW_DATA_CLEAR >> i * 8);
