+		goto error;
+	}
+
+	memset(buf, 0, ROW_SIZE * COL_SIZE * 2);
+
+	while (1) {
+		if (line[q] == ',') {
+			cipher = 1;
+			for (p = 1; (line[q - p] >= '0') && (line[q - p] <= '9'); p++) {
+				buf[tx_num][rx_num] += ((line[q - p] - '0') * cipher);
+				cipher *= 10;
+			}
+			r++;
+			if (r % (int)COL_SIZE == 0) {
+				rx_num = 0;
+				tx_num++;
+			} else {
+				rx_num++;
+			}
+		}
+		q++;
+		if (r == (int)ROW_SIZE * (int)COL_SIZE) {
+			TOUCH_I("panel_spec_file scanning is success\n");
