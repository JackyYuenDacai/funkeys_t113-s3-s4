+static int sw42902_vsync_check(struct device *dev)
+{
+	struct sw42902_data *d = to_sw49202_data(dev);
+	int ret = 0;
+	int timer = 10;
+
+	sw42902_tc_driving(dev, LCD_VSYNC_CHECK);
+
+	while(timer > 0) {
+		if(d->vsync_err) {
+			TOUCH_I("VSYNC is ERROR\n");
+			return d->vsync_err;
+		}
+		timer--;
+		touch_msleep(50);
+	}
+	TOUCH_I("VSYNC is OK\n");
+	return ret;
+}
