+static int s3706_tci_active_area(struct device *dev,
+					u16 x1, u16 y1, u16 x2, u16 y2)
+{
+	struct touch_core_data *ts = to_touch_core(dev);
+	struct s3706_data *d = to_s3706_data(dev);
+
+	u16 active_area[4] = {x1, y1, x2, y2};
