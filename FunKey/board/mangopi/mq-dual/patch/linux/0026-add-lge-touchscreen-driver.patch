+	struct touch_core_data *ts = to_touch_core(dev);
+	struct s3706_data *d = to_s3706_data(dev);
+
+	int ret = 0;
+	int enable = 0;
+	int offset_y = 0;
+	int start_x = 0;
+	int start_y = 0;
+	int width = 0;
+	int height = 0;
+	int end_x = 0;
+	int end_y = 0;
