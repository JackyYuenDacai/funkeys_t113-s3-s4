+	param->used_mode = (1<<LCD_MODE_U0)|(1<<LCD_MODE_U3)|
+		    (1<<LCD_MODE_U2_UNBLANK)|(1<<LCD_MODE_U2)|
+		    (1<<LCD_MODE_U3_QUICKCOVER)|(1<<LCD_MODE_STOP);
+}
