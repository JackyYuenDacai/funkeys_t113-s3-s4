+		TOUCH_I("noise_log = %d, value = %d\n",
+				d->noise_log, value);
+		return count;
+	}
+
+	TOUCH_I("noise_log = %s\n", (d->noise_log == NOISE_ENABLE)
+			? "NOISE_LOG_ENABLE" : "NOISE_LOG_DISABLE");
+
+	return count;
+}
