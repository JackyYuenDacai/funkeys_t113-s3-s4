+		goto error;
+	}
+	TOUCH_I("Response: %d / Write Command: %s / Config Code: %s\n",
+			d->response_code,
+			STR(CMD_SET_LGE_GESTURE_CONFIG),
+			s3618_gesture_config_code_str[buf.gesture_config_code]);
+
+error:
+	return ret;
+}
