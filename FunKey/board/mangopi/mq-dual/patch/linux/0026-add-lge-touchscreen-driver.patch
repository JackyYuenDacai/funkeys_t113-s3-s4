+#endif
+
+	hx83113a_proc_deinit();
+
+	//wake_lock_destroy(&d->ts_SMWP_wake_lock);
+	if (gpio_is_valid(ts->int_pin))
+		gpio_free(ts->int_pin);
+	if (gpio_is_valid(ts->reset_pin))
+		gpio_free(ts->reset_pin);
+
+	kfree(hx_touch_data);
+	kfree(ic_data);
+	kfree(d);
+	probe_fail_flag = 0;
+
+	return 0;
