 	}
 
 	para->feat_init.chn_cfg_mode = g_disp_drv.disp_init.chn_cfg_mode;
-
+	_wrn("[DEBUG] bsp_disp_init callerdisp init mode=%d\n", para->feat_init.chn_cfg_mode);
 	bsp_disp_init(para);
 
 	/*if (bsp_disp_check_device_enabled(para) == 0)
