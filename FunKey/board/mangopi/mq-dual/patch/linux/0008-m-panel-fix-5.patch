+++ b/drivers/video/fbdev/sunxi/disp2/disp/lcd/panels.c
@@ -146,9 +146,10 @@ void lcd_set_panel_funs(void)
 
 int lcd_init(void)
 {
+	printk("panel.c lcd_init start ...\n");
 	sunxi_disp_get_source_ops(&g_lcd_drv.src_ops);
 	lcd_set_panel_funs();
-
+	printk("panel.c lcd_init end ...\n");
 	return 0;
 }
 
