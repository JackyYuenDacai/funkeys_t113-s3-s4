From c96590712e11835e973e67669d7513a68d9fa361 Mon Sep 17 00:00:00 2001
From: Jacky Yuen <jackyyuen10@gmail.com>
Date: Thu, 8 Jan 2026 00:44:55 +0800
Subject: [PATCH 03/31] kernel-g1392-2

Signed-off-by: Jacky Yuen <jackyyuen10@gmail.com>
---
 drivers/video/fbdev/sunxi/disp2/disp/lcd/g1392.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/video/fbdev/sunxi/disp2/disp/lcd/g1392.c b/drivers/video/fbdev/sunxi/disp2/disp/lcd/g1392.c
index 9a2d89f96..901bc450b 100644
--- a/drivers/video/fbdev/sunxi/disp2/disp/lcd/g1392.c
+++ b/drivers/video/fbdev/sunxi/disp2/disp/lcd/g1392.c
@@ -124,6 +124,7 @@ static void lcd_cfg_panel_info(struct panel_extend_para *info)
 
 static s32 lcd_open_flow(u32 sel)
 {
+    __wrn("klcd_open_flow g1392\n");
 	LCD_OPEN_FUNC(sel, lcd_power_on, 0);
 	LCD_OPEN_FUNC(sel, lcd_panel_init, 10);
 	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 10);
@@ -133,6 +134,7 @@ static s32 lcd_open_flow(u32 sel)
 
 static s32 lcd_close_flow(u32 sel)
 {
+    __wrn("klcd_close_flow g1392\n");
 	LCD_CLOSE_FUNC(sel, lcd_bl_close, 0);
 	LCD_CLOSE_FUNC(sel, lcd_panel_exit, 10);
 	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
@@ -143,7 +145,7 @@ static s32 lcd_close_flow(u32 sel)
 
 static void lcd_power_on(u32 sel)
 {
-    
+    __wrn("klcd power on g1392\n");
 	sunxi_lcd_pin_cfg(sel, 1);
 	sunxi_lcd_power_enable(sel, 0);
 	sunxi_lcd_power_enable(sel, 1);
@@ -213,7 +215,7 @@ static struct LCM_setting_table lcm_initialization_setting[] = {
 static void lcd_panel_init(u32 sel)
 {
 	u32 i = 0;
-
+    __wrn("klcd_panel init g1392\n");
 	sunxi_lcd_dsi_clk_enable(sel);
 	sunxi_lcd_delay_ms(10);
 
-- 
