-			      struct, assign, print)		\
-	DECLARE_TRACE_CONDITION(name, PARAMS(proto),		\
-				PARAMS(args), PARAMS(cond))
-
-#define TRACE_EVENT_FLAGS(event, flag)
-
-#define TRACE_EVENT_PERF_PERM(event, expr...)
-
-#define DECLARE_EVENT_NOP(name, proto, args)				\
