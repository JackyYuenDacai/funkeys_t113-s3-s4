-/*
- * validate key length for AES algorithms
- */
-static inline int aes_check_keylen(unsigned int keylen)
-{
-	switch (keylen) {
-	case AES_KEYSIZE_128:
-	case AES_KEYSIZE_192:
-	case AES_KEYSIZE_256:
-		break;
