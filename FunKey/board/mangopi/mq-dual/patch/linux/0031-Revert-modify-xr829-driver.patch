-#define TRACE_EVENT_FN_COND(name, proto, args, cond, struct,		\
-		assign, print, reg, unreg)			\
-	DECLARE_TRACE_CONDITION(name, PARAMS(proto),	\
-			PARAMS(args), PARAMS(cond))
