-static void
-ieee80211_tdls_add_chan_switch_resp_ies(struct ieee80211_sub_if_data *sdata,
-					struct sk_buff *skb, const u8 *peer,
-					u16 status_code, bool initiator,
-					const u8 *extra_ies,
