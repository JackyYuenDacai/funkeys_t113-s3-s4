From 595756047c452a969ba3528457e542c3c6515165 Mon Sep 17 00:00:00 2001
From: Jacky Yuen <jackyyuen10@gmail.com>
Date: Thu, 8 Jan 2026 16:07:44 +0800
Subject: [PATCH] m-panel-fix-7

Signed-off-by: Jacky Yuen <jackyyuen10@gmail.com>
---
 drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c b/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
index 6a568ab17..f1363c5e3 100644
--- a/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
+++ b/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
@@ -3147,8 +3147,10 @@ s32 disp_init_lcd(struct disp_bsp_init_para *para)
 
 	disp = 0;
 	for (hwdev_index = 0; hwdev_index < num_devices; hwdev_index++) {
+		printk("disp_init_lcd hwdev_index=%d\n", hwdev_index);
 		if (!bsp_disp_feat_is_supported_output_types
 		    (hwdev_index, DISP_OUTPUT_TYPE_LCD)) {
+				printk("disp_init_lcd hwdev_index=%d not support lcd  \n", hwdev_index);
 			continue;
 		}
 
