---
 drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c b/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
index f193adbf0..41a8562ef 100644
--- a/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
+++ b/drivers/video/fbdev/sunxi/disp2/disp/de/disp_lcd.c
@@ -3310,8 +3310,9 @@ s32 disp_init_lcd(struct disp_bsp_init_para *para)
 			  disp_close_eink_panel_task);
 #endif
 		printk("disp_lcd_init caller ...\n");
-		set_lcd_timings(para->reg_base[DISP_MOD_LCD0], &lcd->timings);
+
 		disp_lcd_init(lcd, lcd->disp);
+		set_lcd_timings(para->reg_base[DISP_MOD_LCD0], &lcd->timings);
 		printk("disp_device_register caller ...\n");
 		disp_device_register(lcd);
 #if defined(CONFIG_DISP2_LCD_ESD_DETECT)
